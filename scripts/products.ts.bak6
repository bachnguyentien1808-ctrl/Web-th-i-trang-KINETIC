/** Tạo phiên bản màu từ một sản phẩm gốc. */
const colorway = (base: Product, o: Partial<Product> & Pick<Product, "slug" | "name" | "image">, color: string): Product => ({
  ...base, badge: undefined, oldPrice: undefined, ...o, gallery: o.gallery ?? [o.image], family: base.family ?? base.slug, colorLabel: color,
  description: `${base.description} Phiên bản màu ${color}.`,
});

