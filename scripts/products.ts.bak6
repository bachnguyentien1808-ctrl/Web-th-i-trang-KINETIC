/** Danh sách đang dùng = sản phẩm mặc định + sản phẩm admin thêm (được nạp ở trình duyệt, xem lib/catalog.tsx). */
export const products: Product[] = [...baseProducts];

export const thicknessLabel = { 1: "Mỏng", 2: "Vừa", 3: "Dày" } as const;

// Đường dẫn/đơn hàng cũ trỏ tới slug đã đổi → tự chuyển sang sản phẩm mới
const aliases: Record<string, string> = {
  "ao-khoac-gio-trail-techfleece": "ao-thun-audi-revolut-f1-carbon-black",
  "quan-chay-bo-co-gian-xuan": "quan-track-pants-kinetic-audi-f1",
  "quan-short-chay-bo-2-trong-1": "quan-jogger-tech-fleece-kinetic",
  "ao-polo-audi-revolut-f1-vien-xanh-duong": "ao-polo-xe-dua-audi-revolut-f1",
  "ao-polo-audi-revolut-f1-vien-xanh-la": "ao-polo-xe-dua-audi-revolut-f1",
  "balo-roll-top-audi-revolut-f1-vien-cam": "balo-roll-top-hybrid-audi-revolut-f1",
  "balo-roll-top-audi-revolut-f1-vien-ngoc": "balo-roll-top-hybrid-audi-revolut-f1",
  "balo-roll-top-audi-revolut-f1-vien-xanh": "balo-roll-top-hybrid-audi-revolut-f1",
  "balo-roll-top-audi-revolut-f1-vien-hong": "balo-roll-top-hybrid-audi-revolut-f1",
  "mu-luoi-trai-audi-f1-team-so-55-cam": "mu-luoi-trai-audi-f1-team-cap",
  "mu-luoi-trai-audi-f1-team-so-55-ngoc": "mu-luoi-trai-audi-f1-team-cap",
  "mu-luoi-trai-audi-f1-team-so-55-xanh": "mu-luoi-trai-audi-f1-team-cap",
  "mu-luoi-trai-audi-f1-team-so-55-hong": "mu-luoi-trai-audi-f1-team-cap",
};

export const getProduct = (slug: string) => products.find((p) => p.slug === slug) ?? products.find((p) => p.slug === aliases[slug]);

/** Ảnh thu nhỏ (t-*.jpg) tương ứng với ảnh sản phẩm p-*.jpg; ảnh khác (ảnh tải lên, ảnh banner) giữ nguyên. */
export const thumb = (src: string) => src.replace("/products/p-", "/products/t-");

export const formatVnd = (n: number) => `${n.toLocaleString("vi-VN")} ₫`;

// Tên màu của sản phẩm gốc (các phiên bản màu tự mang colorLabel)
const baseColorLabels: Record<string, string> = {
  "ao-gio-packable-ultraboost-spring": "Xanh Mint", "ao-polo-xe-dua-audi-revolut-f1": "Đen Viền Đỏ", "giay-chay-bo-mua-he-airflow": "Đen Xanh Chanh", "quan-track-pants-kinetic-audi-f1": "Đen", "quan-jogger-tech-fleece-kinetic": "Đen Túi Đỏ",
  "ao-khoac-gio-dua-xe-f1-team": "Đen Chỉ Đỏ", "ao-khoac-thermo-shield-sub-zero": "Đen", "ao-khoac-softshell-audi-revolut-f1": "Đen Chỉ Đỏ", "ao-thun-dua-xe-mercedes-amg-f1-team": "Đen", "ao-khoac-da-racing-harsh-den-trang": "Đen Trắng",
  "ao-khoac-dua-xe-nascar-jack-daniels": "Đen", "ao-khoac-dua-xe-harley-davidson-den": "Đen Viền Cam", "ao-polo-dua-xe-toyota-gazoo-racing": "Đen Viền Đỏ", "quan-motocross-genstex-den": "Đen", "bo-do-dap-xe-nu-concept-speed-den": "Đen Họa Tiết Sọc Màu",
  "mu-luoi-trai-adidas-hoa-tiet-do-man": "Đỏ Mận Họa Tiết", "mu-luoi-trai-the-thao-thoang-khi-xam": "Xám", "mu-luoi-trai-mercedes-amg-petronas-trang": "Trắng", "balo-mini-nike-brasilia-jdi-hong": "Hồng Đậm", "giay-sneaker-da-trang-kem": "Trắng Kem",
  "giay-sneaker-chunky-den-camo": "Đen Camo", "giay-sneaker-de-cao-den-do": "Đen Đỏ Trắng", "giay-sneaker-co-cao-vai-det-trang": "Trắng", "quan-jogger-ni-xam-nhat-in-chu-couture": "Xám Nhạt", "quan-jogger-nu-the-thao-hong-mauve-soc-trang": "Hồng Mauve Sọc Trắng",
  "quan-jogger-nam-thun-den-day-rut": "Đen", "giay-speedcat-pro-f1-edition": "Đen Trắng", "ao-gile-audi-revolut-f1-team": "Đen", "giay-dua-kinetic-carbon-elite-pro-v3": "Đen Carbon", "giay-chay-dia-hinh-terrex-gtx": "Đen Cam Gạch",
  "ao-ni-indines-trang": "Trắng", "quan-jeans-ong-suong-rach-goi": "Xanh Nhạt",
  "ao-thun-chay-sieu-thoang-heat-rdy": "Volt Teal", "ao-phao-the-thao-thermo-puffer": "Xanh Băng", "balo-roll-top-hybrid-audi-revolut-f1": "Đen", "mu-luoi-trai-audi-f1-team-cap": "Đen",
  "ao-thun-audi-revolut-f1-carbon-black": "Xám Nhạt", "ao-dap-xe-cycling-club-jersey": "Đỏ", "ao-thun-the-thao-phoi-den-do-gach": "Đỏ Gạch", "ao-thun-dua-xe-aston-martin-f1-team": "Xanh Lục",
  "ao-polo-doi-dua-scuderia-ferrari-do": "Đỏ", "balo-pickleball-jogarbola-xanh-navy": "Xanh Navy", "giay-sneaker-chunky-trang-xam": "Trắng Xám", "quan-jogger-ni-den-in-chu-couture": "Đen", "quan-jogger-nam-den-tui-khoa": "Đen", "quan-jogger-nam-den-soc-trang-bo-gau": "Đen Sọc Trắng", "mu-luoi-trai-la-cam-dat": "Cam Đất", "balo-mini-the-thao-keepfly-do": "Đỏ", "giay-chay-bo-skechers-max-cushioning-trang-tim": "Trắng Tím", "mu-nua-dau-the-thao-hong-pastel": "Hồng Pastel", "mu-luoi-trai-kelme-den": "Đen", "giay-chay-bo-cong-nghe-xanh-cam": "Xanh Cam", "balo-kamito-xanh-navy-hoa-tiet": "Xanh Navy", "giay-sneaker-luoi-mint-boost": "Mint", "giay-luoi-slip-on-det-den-xam": "Đen Xám", "balo-roll-top-outdoor-acg-den": "Dây Tím", "tui-pickleball-kamito-elite-tour-v3": "Đỏ Trắng", "bo-do-dap-xe-nu-tay-dai-hong-tim": "Hồng Tím", "quan-motocross-fox-180-den-trang": "Đen Trắng", "quan-motocross-fox-180-be-neon": "Be Neon",
};

/** Tên màu của một sản phẩm (phiên bản màu → màu riêng; sản phẩm gốc → tên màu đã khai báo; còn lại đoán từ tên). */
export const colorOf = (p: Product): string => {
  if (p.colorLabel) return p.colorLabel;
  if (baseColorLabels[p.slug]) return baseColorLabels[p.slug];
  const m = p.name.match(/\b(Đen|Trắng|Xám|Đỏ|Xanh|Hồng|Tím|Cam|Vàng|Nâu|Be|Kem)(?:\s+[A-ZĐ][\p{L}]+)?/u);
  return m ? m[0] : "Đa sắc";
};

/** Các phiên bản màu cùng một mẫu (gồm cả sản phẩm gốc), theo thứ tự: gốc trước. Chỉ có 1 phần tử = mẫu không có màu khác. */
export const getVariants = (p: Product): { slug: string; image: string; label: string }[] => {
  const fam = p.family ?? p.slug;
  const list = products.filter((x) => (x.family ?? x.slug) === fam);
  return list
    .sort((a, b) => Number(b.slug === fam) - Number(a.slug === fam))
    .map((x) => ({ slug: x.slug, image: x.image, label: colorOf(x) }));
};

/** Thông tin chi tiết hiển thị dưới mô tả: chất liệu, xuất xứ, bảo quản... (suy ra theo loại sản phẩm; chỉnh ở đây nếu cần số liệu thật). */
export const productDetails = (p: Product) => {
  const isShoe = p.category === "giay", isBag = /^(ba-?lo|túi)/i.test(p.name), isCap = /^mũ/i.test(p.name), isPants = p.category === "quan";
  const techParts = p.tech.split("·").map((x) => x.trim()).filter(Boolean);
  const material = techParts.slice(0, 2).join(", ") || "Vải kỹ thuật";
  const care = isShoe
    ? "Vệ sinh bằng khăn ẩm và bàn chải mềm, không giặt máy, không phơi trực tiếp dưới nắng gắt, để khô tự nhiên nơi thoáng mát."
    : isBag || isCap
      ? "Giặt tay nhẹ với nước lạnh, không ngâm lâu, không dùng chất tẩy mạnh, phơi nơi thoáng mát, không sấy nóng."
      : "Giặt máy chế độ nhẹ dưới 30°C, lộn trái khi giặt, không dùng chất tẩy, không sấy nóng, ủi ở nhiệt độ thấp.";
  const sizes = p.sizes.filter((s) => s.inStock).map((s) => s.label).join(" · ");
  const rows: [string, string][] = [
    ["Thương hiệu", "KINETIC"],
    ["Danh mục", p.categoryLabel],
    ["Màu sắc", colorOf(p)],
    ["Chất liệu", material],
    ["Xuất xứ", "Sản xuất tại Việt Nam theo tiêu chuẩn KINETIC"],
    ...(p.spec ? ([["Kiểu dáng", p.spec.length], ["Độ dày", thicknessLabel[p.spec.thickness]]] as [string, string][]) : []),
    [isShoe ? "Size giày" : isBag || isCap ? "Kích cỡ" : "Size có sẵn", sizes || "Tạm hết hàng"],
    ["Hướng dẫn bảo quản", care],
    ["Bảo hành", "24 tháng chính hãng"],
    ["Đổi trả", "30 ngày miễn phí nếu lỗi nhà sản xuất hoặc không vừa size"],
  ];
  const feats = techParts.length ? techParts : [];
  const use = isShoe ? "chạy bộ, tập luyện và mang hằng ngày" : isBag ? "đi học, đi làm và đi tập" : isCap ? "chạy bộ, đi chơi và che nắng" : isPants ? "tập luyện, chạy bộ và mặc hằng ngày" : "tập luyện, thi đấu và mặc hằng ngày";
  return { rows, feats, use };
};

// Mọi sản phẩm đều ghi rõ màu trong tên: sản phẩm gốc chưa có màu trong tên thì thêm " - <màu>" (các phiên bản màu đã có sẵn).
{
  const plain = (s: string) => s.normalize("NFD").replace(/[̀-ͯ]/g, "").replace(/đ/gi, "d").toLowerCase();
  for (const p of baseProducts) {
    if (p.colorLabel) continue;
    const color = colorOf(p), name = plain(p.name);
    if (!plain(color).split(/\s+/).every((w) => name.includes(w))) p.name = `${p.name} - ${color}`;
  }
}
