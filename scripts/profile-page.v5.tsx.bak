"use client";
import Link from "next/link";
import { useEffect, useState } from "react";
import RequireAuth from "@/components/RequireAuth";
import { isAdmin } from "@/lib/admin";
import { useAuth } from "@/lib/auth";
import { loyaltyOf } from "@/lib/loyalty";
import { readOrders } from "@/lib/orders";
import { emptyProfile, fmtBirth, readProfile, saveProfile, type Profile } from "@/lib/profile";
import { toast } from "@/lib/toast";

type Key = "phone" | "birth" | "address";

function ProfileView() {
  const { user, logout } = useAuth();
  const [prof, setProf] = useState<Profile>(emptyProfile);
  const [editing, setEditing] = useState<Key | null>(null);
  const [draft, setDraft] = useState("");
  const [stats, setStats] = useState<{ orders: number; tier: string; color: string; rate: number } | null>(null);
  const admin = !!user && isAdmin(user.email);

  useEffect(() => {
    if (!user) return;
    setProf(readProfile(user.email));
    if (!isAdmin(user.email)) {
      const orders = readOrders(user.email), l = loyaltyOf(orders);
      setStats({ orders: orders.length, tier: l.tier.name, color: l.tier.color, rate: l.tier.rate });
    }
  }, [user]);
  if (!user) return null;

  const filled = 2 + [prof.phone, prof.birth, prof.address].filter(Boolean).length;
  const pct = Math.round((filled / 5) * 100);
  const tierColor = stats?.color ?? "#e2fa1e";

  const start = (k: Key) => { setEditing(k); setDraft(prof[k]); };
  const save = (e: React.FormEvent) => {
    e.preventDefault();
    if (!editing) return;
    const next = { ...prof, [editing]: draft.trim() };
    if (saveProfile(user.email, next)) { setProf(next); setEditing(null); toast("Thông tin cá nhân của bạn đã được cập nhật.", { title: "Đã lưu thay đổi" }); }
    else toast("Không lưu được, bộ nhớ trình duyệt đã đầy.", { type: "error" });
  };

  const row = (k: Key | null, label: string, value: string, input?: React.ReactNode) => (
    <div className={`pf2-row${k && editing === k ? " editing" : ""}`}>
      <span className="pf2-label">{label}</span>
      <div className="pf2-value">
        {k && editing === k ? (
          <form onSubmit={save}>
            {input}
            <div className="pf2-ed"><button className="pf2-save" type="submit">Lưu</button><button type="button" className="pf2-cancel" onClick={() => setEditing(null)}>Huỷ</button></div>
          </form>
        ) : <b className={value ? "" : "none"}>{value || "Chưa cập nhật"}</b>}
      </div>
      {k && editing !== k && <button className="pf2-edit" onClick={() => start(k)} aria-label={`Sửa ${label}`}>Sửa</button>}
    </div>
  );

  return (
    <div className="pf2">
      <div className="container">
        <header className="pf2-hero" style={{ ["--tier" as string]: tierColor }}>
          <div className="pf2-id">
            <span className="pf2-avatar">{user.name.trim().charAt(0).toUpperCase()}</span>
            <div>
              <p className="pf2-eyebrow">{admin ? "QUẢN TRỊ VIÊN" : stats ? `HỘI VIÊN HẠNG ${stats.tier.toUpperCase()}` : "TÀI KHOẢN"}</p>
              <h1>{user.name}</h1>
              <p className="pf2-mail">{user.email}</p>
            </div>
          </div>
          <div className="pf2-stats">
            {!admin && stats && <><div><b>{stats.orders}</b><span>Đơn hàng</span></div><div><b>{stats.rate}%</b><span>Tích điểm</span></div></>}
            <div><b>{pct}%</b><span>Hồ sơ</span></div>
          </div>
        </header>

        <div className="pf2-grid">
          <section className="pf2-card">
            <h2>Thông tin tài khoản</h2>
            {row(null, "Họ và tên", user.name)}
            {row(null, "Email", user.email)}
          </section>
          <section className="pf2-card">
            <h2>Thông tin liên hệ</h2>
            {row("phone", "Số điện thoại", prof.phone, <input inputMode="tel" maxLength={15} value={draft} autoFocus onChange={(e) => setDraft(e.target.value.replace(/[^\d+ ]/g, ""))} placeholder="0901 234 567" />)}
            {row("birth", "Ngày sinh", fmtBirth(prof.birth), <input type="date" value={draft} max={new Date().toISOString().slice(0, 10)} autoFocus onChange={(e) => setDraft(e.target.value)} />)}
            {row("address", "Địa chỉ giao hàng", prof.address, <textarea rows={3} maxLength={200} value={draft} autoFocus onChange={(e) => setDraft(e.target.value)} placeholder="Số nhà, đường, phường/xã, quận/huyện, tỉnh/thành" />)}
          </section>
        </div>

        <nav className="pf2-links">
          {admin ? <Link href="/admin"><b>Trang quản trị</b><span>Quản lý đơn hàng, sản phẩm</span></Link> : <>
            <Link href="/orders"><b>Đơn hàng của tôi</b><span>Theo dõi và đánh giá đơn</span></Link>
            <Link href="/account"><b>Thẻ & điểm hội viên</b><span>Hạng thẻ, điểm thưởng, ưu đãi</span></Link>
          </>}
          <button onClick={logout}><b>Đăng xuất</b><span>Thoát khỏi tài khoản này</span></button>
        </nav>
      </div>
    </div>
  );
}

export default function ProfilePage() { return <RequireAuth><ProfileView /></RequireAuth>; }
