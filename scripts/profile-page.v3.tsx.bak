"use client";
import Link from "next/link";
import { useEffect, useMemo, useState } from "react";
import RequireAuth from "@/components/RequireAuth";
import { isAdmin } from "@/lib/admin";
import { useAuth } from "@/lib/auth";
import { loyaltyOf } from "@/lib/loyalty";
import { readOrders } from "@/lib/orders";
import { emptyProfile, fmtBirth, readProfile, saveProfile, type Profile } from "@/lib/profile";
import { toast } from "@/lib/toast";

function ProfileView() {
  const { user, logout } = useAuth();
  const [prof, setProf] = useState<Profile>(emptyProfile);
  const [edit, setEdit] = useState(false);
  const [stats, setStats] = useState<{ orders: number; tier: string; color: string; rate: number } | null>(null);
  const admin = !!user && isAdmin(user.email);

  useEffect(() => {
    if (!user) return;
    setProf(readProfile(user.email));
    if (!isAdmin(user.email)) {
      const orders = readOrders(user.email), l = loyaltyOf(orders);
      setStats({ orders: orders.length, tier: l.tier.name, color: l.tier.color, rate: l.tier.rate });
    }
  }, [user]);

  const fields = useMemo(() => [prof.phone, prof.birth, prof.address], [prof]);
  if (!user) return null;
  const done = 2 + fields.filter(Boolean).length; // họ tên + email luôn có
  const pct = Math.round((done / 5) * 100);

  const submit = (e: React.FormEvent) => {
    e.preventDefault();
    if (saveProfile(user.email, prof)) { setEdit(false); toast("Thông tin cá nhân của bạn đã được cập nhật.", { title: "Đã lưu thay đổi" }); }
    else toast("Không lưu được, bộ nhớ trình duyệt đã đầy.", { type: "error" });
  };

  const row = (label: string, value: string) => (
    <div className={value ? "pc-row" : "pc-row empty"}><span>{label}</span><b>{value || "Chưa cập nhật"}</b></div>
  );
  const quick: [string, string, string][] = admin
    ? [["/admin", "Trang quản trị", "Quản lý đơn hàng, sản phẩm"]]
    : [["/orders", "Đơn hàng của tôi", "Theo dõi và đánh giá đơn"], ["/account", "Thẻ & điểm hội viên", stats ? `Hạng ${stats.tier} · tích điểm ${stats.rate}%` : "Ưu đãi hội viên"]];

  return (
    <div className="pc-page">
      <div className="container">
        <header className="pc-hero">
          <div className="pc-cover"><i /><i /><i /></div>
          <div className="pc-id">
            <span className="pc-avatar">{user.name.trim().charAt(0).toUpperCase()}</span>
            <div className="pc-name">
              <h1>{user.name}</h1>
              <p>{user.email}</p>
              <div className="pc-tags">
                {admin ? <span className="pc-tag dark">QUẢN TRỊ VIÊN</span> : stats && <><span className="pc-tag" style={{ ["--tier" as string]: stats.color }}>● HẠNG {stats.tier.toUpperCase()}</span><span className="pc-tag light">{stats.orders} đơn hàng</span></>}
              </div>
            </div>
            <div className="pc-btns">
              {!edit && <button className="pc-btn primary" onClick={() => setEdit(true)}>Chỉnh sửa hồ sơ</button>}
              <button className="pc-btn" onClick={logout}>Đăng xuất</button>
            </div>
          </div>
        </header>

        <div className="pc-body">
          <div className="pc-col">
            {!edit ? (
              <>
                <section className="pc-card">
                  <h2>Thông tin cá nhân</h2>
                  {row("Họ và tên", user.name)}
                  {row("Ngày sinh", fmtBirth(prof.birth))}
                </section>
                <section className="pc-card">
                  <h2>Thông tin liên hệ</h2>
                  {row("Số điện thoại", prof.phone)}
                  {row("Email", user.email)}
                  {row("Địa chỉ giao hàng", prof.address)}
                </section>
              </>
            ) : (
              <form className="pc-card pc-form" onSubmit={submit}>
                <h2>Chỉnh sửa hồ sơ</h2>
                <div className="pc-fields">
                  <label className="ro"><span>Họ và tên</span><input value={user.name} disabled /></label>
                  <label className="ro"><span>Email</span><input value={user.email} disabled /></label>
                  <label><span>Số điện thoại</span><input inputMode="tel" value={prof.phone} maxLength={15} onChange={(e) => setProf({ ...prof, phone: e.target.value.replace(/[^\d+ ]/g, "") })} placeholder="0901 234 567" autoFocus /></label>
                  <label><span>Ngày sinh</span><input type="date" value={prof.birth} max={new Date().toISOString().slice(0, 10)} onChange={(e) => setProf({ ...prof, birth: e.target.value })} /></label>
                  <label className="wide"><span>Địa chỉ giao hàng</span><textarea rows={3} value={prof.address} maxLength={200} onChange={(e) => setProf({ ...prof, address: e.target.value })} placeholder="Số nhà, đường, phường/xã, quận/huyện, tỉnh/thành" /></label>
                </div>
                <div className="pc-actions">
                  <button type="submit" className="pc-btn primary">Lưu thay đổi</button>
                  <button type="button" className="pc-btn" onClick={() => { setEdit(false); setProf(readProfile(user.email)); }}>Huỷ</button>
                </div>
              </form>
            )}
          </div>

          <aside className="pc-col">
            <section className="pc-card pc-ring">
              <div className="pc-donut" style={{ ["--p" as string]: `${pct}%` }}><b>{pct}%</b></div>
              <div><h2>Hoàn thiện hồ sơ</h2><p>{pct === 100 ? "Hồ sơ của bạn đã đầy đủ. Cảm ơn bạn!" : "Bổ sung số điện thoại, ngày sinh và địa chỉ để đặt hàng nhanh hơn."}</p></div>
            </section>
            <section className="pc-card">
              <h2>Lối tắt</h2>
              <div className="pc-quick">
                {quick.map(([href, title, sub]) => (
                  <Link key={href} href={href}><span><b>{title}</b><small>{sub}</small></span><i>→</i></Link>
                ))}
              </div>
            </section>
          </aside>
        </div>
      </div>
    </div>
  );
}

export default function ProfilePage() { return <RequireAuth><ProfileView /></RequireAuth>; }
