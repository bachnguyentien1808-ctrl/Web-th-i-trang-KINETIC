import images from "./images.json";

// Ảnh sản phẩm là ảnh cục bộ trong public/products (tạo bằng scripts/make-product-images.js).
const img = images as Record<string, string>;
const I = (key: string) => img[key];

export type Category = "ao" | "quan" | "giay" | "phu-kien";
export type Season = "xuan" | "ha" | "thu" | "dong";

export interface Product {
  slug: string;
  name: string;
  category: Category;
  categoryLabel: string;
  season?: Season;
  price: number;
  oldPrice?: number;
  badge?: "BESTSELLER" | "MEMBER ONLY" | "LIMITED DROP" | "SALE" | "NEW DROP";
  image: string;
  gallery: string[];
  rating: number;
  reviews: number;
  sizes: { label: string; inStock: boolean }[];
  description: string;
  tech: string;
  family?: string; // slug sản phẩm gốc - các phiên bản màu dùng chung để chọn màu ở trang chi tiết
  colorLabel?: string;
  spec?: { length: string; thickness: 1 | 2 | 3 }; // chiều dài (tay/ống) và độ dày (1 mỏng · 2 vừa · 3 dày)
}

const clothing = ["S", "M", "L", "XL", "XXL"].map((label) => ({ label, inStock: label !== "XXL" }));
const shoes = ["39", "40", "41", "42", "43", "44"].map((label) => ({ label, inStock: label !== "44" }));
const oneSize = [{ label: "FREE SIZE", inStock: true }];
const liters = [{ label: "25 LÍT", inStock: true }, { label: "32 LÍT", inStock: true }];

export const categories: { slug: Category; label: string }[] = [
  { slug: "ao", label: "Áo" },
  { slug: "quan", label: "Quần" },
  { slug: "giay", label: "Giày" },
  { slug: "phu-kien", label: "Phụ kiện" },
];

