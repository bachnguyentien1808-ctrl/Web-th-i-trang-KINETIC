:root{--black:#000;--ink:#151515;--volt:#e2fa1e;--red:#e32b2b;--concrete:#f7f8f2;--line:#e5e5e5;--grey:#767676;
--display:'Bebas Neue',Impact,sans-serif;--label:'Montserrat',Arial,sans-serif;--body:'Inter',system-ui,sans-serif}
*{box-sizing:border-box;margin:0;padding:0;border-radius:0}
body{font-family:var(--body);color:var(--ink);background:#fff;line-height:1.5}
a{color:inherit;text-decoration:none}button{font:inherit;cursor:pointer;background:none;border:0;color:inherit}
img{display:block}
.container{max-width:1440px;margin:0 auto;padding:0 16px}
@media(min-width:768px){.container{padding:0 32px}}@media(min-width:1024px){.container{padding:0 48px}}
.section{padding-top:40px;padding-bottom:40px}.center{text-align:center}.pad{padding:16px 0}.muted{color:var(--grey)}.small{font-size:12px}
h1,h2,h3{font-family:var(--display);font-weight:400;text-transform:uppercase;letter-spacing:.03em;line-height:1}
.h1{font-size:clamp(36px,5vw,48px)}
.btn{display:inline-block;text-align:center;font-family:var(--label);font-weight:800;font-size:13px;letter-spacing:.12em;text-transform:uppercase;padding:16px 28px;border:2px solid #000;transition:none}
.btn-black{background:var(--volt);color:#000}.btn-black:hover{background:#fff;color:#000}
.btn-outline{background:transparent;color:#000}.btn-outline:hover{background:#000;color:#fff}
.btn-outline.light{border-color:#000;color:#000}.btn-outline.light:hover{background:var(--volt)}
.btn-yellow{background:var(--volt);color:#000}.btn-yellow:hover{background:#000;color:var(--volt)}
.btn.full{display:block;width:100%}.btn.disabled{opacity:.4;pointer-events:none}
.badge{font-family:var(--label);font-weight:800;font-size:11px;letter-spacing:.08em;padding:4px 8px;display:inline-block}
.b-black{background:#2a2a2a;color:#fff}.b-volt{background:var(--volt);color:#000}.b-red{background:var(--red);color:#fff}
.price{font-family:var(--label);font-weight:800;font-variant-numeric:tabular-nums;letter-spacing:-.02em}
/* header */
.header{position:sticky;top:0;z-index:30;background:#fff;border-bottom:1px solid var(--line)}
.topbar{background:#f0ff8a;color:#000;font-family:var(--label);font-weight:800;font-size:11px;letter-spacing:.08em;text-align:center;padding:6px 8px}
.nav{display:flex;align-items:center;gap:20px;height:64px}
.logo{display:flex;align-items:center;gap:10px;font-family:var(--display);font-size:32px;letter-spacing:.06em}
.logo.light{color:#000;margin-bottom:12px}
.stripes{display:flex;gap:3px}.stripes i{display:block;width:6px;height:22px;background:currentColor;transform:skewX(-12deg)}
.stripes i:nth-child(2){height:28px}.stripes i:nth-child(3){height:34px}
.stripes{align-items:flex-end}
.links{display:flex;gap:22px;margin-left:16px;font-family:var(--label);font-weight:800;font-size:12px;letter-spacing:.1em;text-transform:uppercase}
.links a:hover{box-shadow:0 2px 0 #000}.sale-link{color:var(--red)}
.search{margin-left:auto}.search input{height:40px;width:220px;border:1px solid var(--ink);padding:0 12px;font-size:13px;font-family:var(--body)}
.search input:focus{outline:0;border-width:2px}
.cart-btn{font-family:var(--label);font-weight:800;font-size:12px;letter-spacing:.1em;display:flex;align-items:center;gap:8px}
.cart-count{background:var(--volt);color:#000;min-width:22px;height:22px;display:grid;place-items:center;font-size:11px}
.menu-btn{display:none;font-size:22px}
@media(max-width:900px){.menu-btn{display:block}.search{display:none}.cart-btn{margin-left:auto}
.links{display:none;position:absolute;top:100%;left:0;right:0;background:#fff;flex-direction:column;padding:16px;margin:0;border-bottom:1px solid var(--line);gap:16px}.links.open{display:flex}}
/* hero */
.hero{background:linear-gradient(135deg,#ffffff 0%,#fbffd9 55%,#f0ff8a 100%);color:#000;padding:96px 0}
.hero h1{font-size:clamp(56px,10vw,140px);line-height:.9;margin:16px 0}.hero .volt{background:var(--volt);color:#000;padding:0 12px}
.hero p{max-width:520px;color:#222;font-weight:500}.tag{font-family:var(--label);font-weight:800;font-size:11px;letter-spacing:.12em;background:var(--volt);color:#000;padding:4px 8px}
.hero .btn-yellow:hover{background:#fff;color:#000}.hero-cta{display:flex;gap:12px;margin-top:32px;flex-wrap:wrap}
.sec-head{display:flex;align-items:baseline;justify-content:space-between;gap:16px;margin-bottom:24px;border-bottom:2px solid #000;padding-bottom:8px}
.sec-head h2{font-size:clamp(28px,4vw,40px)}.more{font-family:var(--label);font-weight:800;font-size:12px;letter-spacing:.1em}
/* grids */
.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}
@media(min-width:900px){.grid{grid-template-columns:repeat(4,1fr);gap:24px}}
.card{display:block;border:1px solid var(--line);background:#fff}.card:hover{border-color:#000;box-shadow:0 0 0 1px #000}
.card-img{position:relative;aspect-ratio:4/5;background:var(--concrete);overflow:hidden}
.card-img img{object-fit:cover}.card-img .badge{position:absolute;top:8px;left:8px;z-index:2}
.img-b{opacity:0;transition:opacity .15s linear}.card:hover .img-b{opacity:1}
.card-info{padding:14px}.cat{font-size:11px;color:var(--grey);font-weight:500}
.card-info h3{font-family:var(--label);font-weight:700;font-size:14px;letter-spacing:.02em;text-transform:none;line-height:1.3;margin:4px 0 8px;min-height:36px}
.prices{display:flex;gap:8px;align-items:baseline}.prices s{color:var(--grey);font-size:12px}
.seasons{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}
@media(min-width:900px){.seasons{grid-template-columns:repeat(4,1fr)}}
.season{border:1px solid var(--line)}.season.hot{border:2px solid var(--volt);background:var(--volt)}
.season-img{position:relative;aspect-ratio:3/4}.season-img img{object-fit:cover}
.season-info{padding:16px;background:#fff}.season h3{font-size:30px;margin:2px 0 12px}.season small{font-family:var(--label);font-weight:800;font-size:11px;letter-spacing:.08em;text-transform:uppercase}
.season .btn{padding:10px 14px;font-size:11px;display:block}
.perks{background:var(--concrete);margin-top:24px}
.perk-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:24px;padding-top:32px;padding-bottom:32px}
@media(min-width:900px){.perk-grid{grid-template-columns:repeat(4,1fr)}}
.perk-grid b{display:block;font-family:var(--label);font-size:12px;letter-spacing:.1em}.perk-grid span{font-size:13px;color:var(--grey)}
/* filters */
.filters{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:24px}.spacer{flex:1}
.chip{border:1px solid var(--line);padding:8px 16px;font-family:var(--label);font-weight:800;font-size:12px;letter-spacing:.06em;text-transform:uppercase}
.chip:hover{background:var(--concrete)}.chip.on{background:var(--volt);color:#000;border-color:#000}
/* pdp */
.crumbs{font-size:12px;color:var(--grey);margin-bottom:20px}.crumbs a:hover{color:#000}
.pdp{display:grid;gap:32px}@media(min-width:900px){.pdp{grid-template-columns:1.1fr 1fr;gap:48px}}
.gallery-main{position:relative;aspect-ratio:1/1;background:var(--concrete)}.gallery-main img{object-fit:cover}
.thumbs{display:flex;gap:8px;margin-top:8px;flex-wrap:wrap}.thumb{position:relative;width:80px;height:80px;border:2px solid transparent;background:var(--concrete)}
.thumb.on{border-color:#000}.thumb img{object-fit:cover}
.pdp-info h1{font-size:clamp(32px,4vw,44px);line-height:1.05;margin:6px 0 10px}
.rating{font-size:13px;font-weight:600}.rating span{color:var(--grey);font-weight:400}
.pdp-price{display:flex;align-items:center;gap:12px;margin:16px 0}.pdp-price b{font-family:var(--label);font-weight:800;font-size:30px;letter-spacing:-.02em}
.pdp-price s{color:var(--grey)}.desc{margin-bottom:8px}.tech{font-family:var(--label);font-weight:700;font-size:11px;letter-spacing:.08em;color:var(--grey);text-transform:uppercase;margin-bottom:24px}
.size-head{display:flex;justify-content:space-between;font-family:var(--label);font-size:12px;letter-spacing:.1em;margin-bottom:8px}.err{color:var(--red);font-size:12px}
.sizes{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:20px}
.size{min-width:56px;height:48px;padding:0 14px;border:1px solid var(--line);font-family:var(--label);font-weight:800;font-size:13px;position:relative}
.size:hover:not(:disabled){background:var(--concrete)}.size.sel{background:var(--volt);color:#000;border-color:#000;box-shadow:inset 0 0 0 1px #000}
.size.oos{color:#bbb;cursor:not-allowed;overflow:hidden}.size.oos::after{content:"";position:absolute;inset:0;background:linear-gradient(to top right,transparent calc(50% - 1px),#bbb,transparent calc(50% + 1px))}
.atc-row{display:flex;gap:12px;margin-bottom:12px}.atc-row .btn{flex:1}
.qty{display:flex;align-items:center;gap:8px}.qty button{width:28px;height:28px;border:1px solid var(--line)}.qty button:hover{background:var(--concrete)}
.qty.big{border:2px solid #000;padding:0 8px}.qty.big button{border:0;width:32px;height:48px;font-size:18px}
.policy{list-style:none;margin-top:24px;display:grid;gap:8px;font-size:13px;background:var(--concrete);padding:16px}.policy b{font-family:var(--label);font-size:11px;letter-spacing:.08em}
/* drawer */
.overlay{position:fixed;inset:0;background:rgba(0,0,0,.6);opacity:0;pointer-events:none;z-index:40}.overlay.show{opacity:1;pointer-events:auto}
.drawer{position:fixed;top:0;right:0;bottom:0;width:min(440px,100%);background:#fff;z-index:50;display:flex;flex-direction:column;transform:translateX(100%);transition:transform .2s linear;border-left:1px solid #000}
.drawer.show{transform:none}.drawer-head{display:flex;justify-content:space-between;align-items:center;padding:20px;border-bottom:1px solid var(--line)}.drawer-head h2{font-size:28px}
.drawer-body{flex:1;overflow:auto;padding:20px}
.line{display:grid;grid-template-columns:80px 1fr auto;gap:12px;padding-bottom:16px;margin-bottom:16px;border-bottom:1px solid var(--line)}
.line-img{position:relative;width:80px;height:100px;background:var(--concrete)}.line-img img{object-fit:cover}
.line-info{display:flex;flex-direction:column;gap:4px;font-size:13px;font-weight:600}.line-info small{color:var(--grey);font-weight:400}
.rm{width:auto!important;border:0!important;text-decoration:underline;font-size:12px;color:var(--grey);margin-left:8px}
.drawer-foot{background:var(--concrete);color:#000;border-top:2px solid #000;padding:20px;display:grid;gap:14px}
.total{display:flex;justify-content:space-between;align-items:center;font-family:var(--label);font-size:12px;letter-spacing:.1em}.total b{font-size:24px;letter-spacing:-.02em}
/* checkout */
.co{display:grid;gap:32px;margin-top:24px}@media(min-width:900px){.co{grid-template-columns:1.4fr 1fr}}
.co h3{font-size:26px;margin:24px 0 12px}.co h3:first-child{margin-top:0}
.field{display:block;margin-bottom:14px}.field span{display:block;font-family:var(--label);font-weight:800;font-size:11px;letter-spacing:.1em;margin-bottom:6px}
.field input{width:100%;height:48px;border:1px solid var(--ink);padding:0 12px;font:inherit}.field input:focus{outline:0;border:2px solid #000}
.field.bad input{border:2px solid var(--red)}.field em{color:var(--red);font-size:12px;font-style:normal}
.two{display:grid;gap:14px}@media(min-width:600px){.two{grid-template-columns:1fr 1fr}}
.radio{display:flex;align-items:center;gap:12px;padding:14px;border:1px solid var(--line);margin-bottom:8px;cursor:pointer;font-size:14px}
.radio input{appearance:none;width:20px;height:20px;border:2px solid var(--ink);display:grid;place-items:center}
.radio input:checked::after{content:"";width:10px;height:10px;background:#000}.radio i{display:none}
.co form .btn{margin-top:20px}.co form .muted{margin-top:12px}
.summary{background:var(--concrete);padding:24px;align-self:start;border:1px solid var(--line)}
.sum-line{display:flex;justify-content:space-between;gap:12px;padding:8px 0;font-size:14px;border-bottom:1px solid var(--line)}.sum-line small{color:var(--grey)}
.sum-total{display:flex;justify-content:space-between;align-items:center;padding-top:16px;font-family:var(--label);font-weight:800;letter-spacing:.1em}.sum-total b{font-size:24px}
.check{width:72px;height:72px;background:var(--volt);display:grid;place-items:center;font-size:36px;font-weight:800;margin:0 auto 16px}
/* footer */
.footer{background:#fbffd9;border-top:2px solid var(--volt);color:#000;margin-top:0;padding-top:48px}
.fgrid{display:grid;gap:32px}@media(min-width:900px){.fgrid{grid-template-columns:2fr 1fr 1fr 1.3fr}}
.footer p,.footer .fgrid>div>span,.footer a{font-size:13px;color:#222;display:block;margin-bottom:8px}.footer a:hover{text-decoration:underline}
.footer h4{font-family:var(--label);font-weight:800;font-size:12px;letter-spacing:.1em;text-transform:uppercase;margin-bottom:14px}
.copy{border-top:1px solid rgba(0,0,0,.25);margin-top:32px;padding-top:16px;padding-bottom:24px;font-size:12px;color:#333}
/* ===== Home banners ===== */
.home{padding-top:16px;padding-bottom:32px;display:grid;gap:16px}
.hb-hero,.hb-collection,.hb-banner,.hb-sale,.hb-tile{border-radius:14px!important;overflow:hidden}
.hb-hero{display:grid;background:linear-gradient(120deg,#eaf4ff,#fbffd9);min-height:360px}
@media(min-width:900px){.hb-hero{grid-template-columns:1fr 1fr}}
.hb-hero-text{padding:40px 32px;display:flex;flex-direction:column;align-items:flex-start;gap:14px;z-index:1}
.hb-hero h1{font-family:var(--label);font-weight:800;font-size:clamp(28px,4vw,52px);line-height:1.08;letter-spacing:-.01em}
.hb-hero p{color:#333}
.pill{border-radius:999px!important;padding:14px 28px}
.hb-perks{display:flex;gap:24px;margin-top:12px;font-size:12px;color:#444}
.hb-perks span{display:block;font-size:20px;margin-bottom:2px}
.hb-hero-img{position:relative;min-height:300px}.hb-hero-img img{object-fit:cover;object-position:center 20%}
.script{position:absolute;right:24px;top:40px;font-family:'Brush Script MT',cursive;font-style:italic;font-size:26px;color:#fff;text-shadow:0 1px 8px rgba(0,0,0,.4);line-height:1.1}
.hb-tiles{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}
@media(min-width:900px){.hb-tiles{grid-template-columns:repeat(4,1fr)}}
.hb-tile{position:relative;aspect-ratio:3/4;color:#fff;display:flex;flex-direction:column;justify-content:space-between;padding:16px}
@media(min-width:900px){.hb-tile{aspect-ratio:1/1.05}}
.hb-tile img,.hb-banner img,.hb-sale>img,.hb-col-img img{object-fit:cover}
.hb-shade{position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,.65),rgba(0,0,0,.05) 60%)}
.hb-shade.wide{background:linear-gradient(to right,rgba(0,0,0,.7),rgba(0,0,0,.15))}
.hb-tile small,.hb-tile-txt{position:relative;z-index:1}
.hb-tile small{font-family:var(--label);font-weight:700;font-size:11px;letter-spacing:.1em}
.hb-tile h3{font-family:var(--label);font-weight:800;font-size:clamp(14px,1.6vw,20px);line-height:1.15}
.hb-tile p{font-size:12px;opacity:.9;margin:4px 0 10px}
.ghost-btn{display:inline-block;border:1.5px solid #fff;border-radius:999px;padding:6px 16px;font-family:var(--label);font-weight:800;font-size:11px;letter-spacing:.06em}
.hb-tile:hover .ghost-btn,.hb-banner:hover .ghost-btn{background:#fff;color:#000}
.hb-collection{display:grid;background:#f3f6ea;border:1px solid var(--line)}
@media(min-width:900px){.hb-collection{grid-template-columns:1.1fr 1fr 1.1fr}}
.hb-col-left{background:linear-gradient(120deg,#fbffd9,#f0ff8a);padding:32px;display:flex;flex-direction:column;align-items:flex-start;gap:12px;justify-content:center}
.hb-col-left small,.hb-banner small{font-family:var(--label);font-weight:800;font-size:11px;letter-spacing:.1em}
.hb-col-left h2{font-family:var(--label);font-weight:800;font-size:clamp(24px,3vw,38px);line-height:1.1;letter-spacing:-.01em;text-transform:none}
.hb-col-img{position:relative;min-height:260px}
.hb-col-right{padding:24px;display:grid;gap:16px;align-content:center}
.mini-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}.mini{position:relative;aspect-ratio:1/1;background:#fff;border-radius:8px;overflow:hidden}.mini img{object-fit:cover}
.hb-col-right ul{list-style:none;display:grid;gap:8px;font-size:13px}.hb-col-right b{display:inline-block;width:24px}
.grid.six{grid-template-columns:repeat(2,1fr)}
@media(min-width:900px){.grid.six{grid-template-columns:repeat(3,1fr)}}@media(min-width:1200px){.grid.six{grid-template-columns:repeat(6,1fr)}}
.grid.six .card{border-radius:10px;overflow:hidden}
.hb-featured .sec-head{border-bottom:0}
.hb-duo{display:grid;gap:16px}@media(min-width:900px){.hb-duo{grid-template-columns:1fr 1fr}}
.hb-banner{position:relative;min-height:240px;color:#fff;display:flex;align-items:center;padding:32px}
.hb-banner-txt{position:relative;z-index:1;display:grid;gap:8px;justify-items:start}
.hb-banner h2{font-family:var(--label);font-weight:800;font-size:clamp(24px,3vw,36px);line-height:1.1;text-transform:none}
.hb-sale{position:relative;min-height:260px;color:#fff;display:grid;align-items:center;padding:32px;gap:24px}
@media(min-width:900px){.hb-sale{grid-template-columns:1.2fr 1fr}}
.hb-sale-txt{position:relative;z-index:1;display:grid;gap:10px;justify-items:start}
.hb-sale h2{font-family:var(--label);font-weight:800;font-size:clamp(26px,3.5vw,44px);line-height:1.1;text-transform:none}.hb-sale h2 span{color:var(--volt)}
.hb-sale-perks{position:relative;z-index:1;display:flex;gap:28px;font-size:12px;justify-content:flex-end}.hb-sale-perks b{display:block;font-size:22px}
/* utility row + auth */
.utility{display:flex;justify-content:flex-end;align-items:center;gap:18px;font-size:11px;padding-top:6px;padding-bottom:2px;color:#444}
.utility button,.utility a{font-size:11px;color:#444}.utility a:hover,.utility button:hover{text-decoration:underline;color:#000}
.utility .reg{font-weight:800;color:#000}.hello{color:#000}
.icon-btn{display:grid;place-items:center}
.cart-btn{gap:6px}
@media(max-width:700px){.utility a:not(.reg):not([href="/login"]),.utility .hello{display:none}}
.auth{max-width:440px;margin:0 auto;padding:32px 0}
.auth form{margin-top:20px}
.notice{background:#fbffd9;border-left:4px solid var(--volt);padding:12px 14px;margin-top:12px;font-size:14px}
.form-err{background:#ffeaea;color:var(--red);padding:10px 12px;font-size:13px;margin-bottom:12px}.form-err a{text-decoration:underline;font-weight:700}
.switch{margin-top:20px;font-size:14px;text-align:center}.switch a{font-weight:700;text-decoration:underline}
.auth .btn:disabled{opacity:.5}
/* address, notes, orders, help */
.field select,.field textarea{width:100%;border:1px solid var(--ink);padding:0 12px;font:inherit;background:#fff;height:48px}
.field textarea{height:auto;padding:10px 12px;resize:vertical}.field select:focus,.field textarea:focus{outline:0;border:2px solid #000}
.field select:disabled{background:var(--concrete);color:#999}.field.bad select{border:2px solid var(--red)}
.note-field{margin-bottom:16px}.note-field span{font-size:11px}
.line-note{border:1px solid var(--line);padding:6px 8px;font-size:12px;font-family:var(--body);width:100%;margin-top:4px}.line-note:focus{outline:0;border-color:#000}
.note{display:block;color:#555;font-style:italic;font-size:12px;font-weight:400}
.order{border:1px solid var(--line);padding:20px;margin-top:16px}.order-head{display:flex;gap:16px;align-items:center;flex-wrap:wrap;margin-bottom:8px}
.ul{text-decoration:underline;font-weight:700}
.faq{display:grid;gap:8px;margin-top:20px}.faq details{border:1px solid var(--line);padding:14px 16px}.faq summary{cursor:pointer;font-weight:700}.faq p{margin-top:8px;color:#444}
.store-list{display:grid;gap:12px;margin-top:20px}@media(min-width:900px){.store-list{grid-template-columns:repeat(3,1fr)}}
.store{border:1px solid var(--line);padding:20px;background:var(--concrete)}.store h3{font-size:26px;margin-bottom:6px}
/* payment banners */
.pay-banner{display:grid;gap:16px;align-items:center;background:linear-gradient(120deg,#fbffd9,#f0ff8a);border-radius:14px;padding:20px 24px;margin:16px 0 8px;overflow:hidden}
@media(min-width:900px){.pay-banner{grid-template-columns:1fr auto}}
.pay-banner h2{font-family:var(--label);font-weight:800;font-size:clamp(20px,2.4vw,28px);text-transform:none;line-height:1.15;margin:8px 0 4px}.pay-banner p{font-size:13px;color:#333}
.pay-banner-imgs{display:flex;gap:10px;justify-content:flex-end}
.pay-thumb{position:relative;width:96px;height:112px;background:#fff;border-radius:10px;overflow:hidden;border:2px solid #fff}.pay-thumb img{object-fit:cover}
.pay-thumb span{position:absolute;right:4px;bottom:4px;background:#000;color:var(--volt);font-size:11px;font-weight:800;padding:1px 6px;font-family:var(--label)}
.pay-banner.done{display:flex;justify-content:center;margin:20px auto;max-width:640px}.pay-banner.done .pay-banner-imgs{justify-content:center;flex-wrap:wrap}
.sum-line{align-items:center}.sum-img{position:relative;width:56px;height:68px;flex:none;background:#fff;overflow:hidden}.sum-img img{object-fit:cover}.sum-name{flex:1}
/* cart page (adidas-style) */
.cart-title{display:flex;align-items:baseline;gap:16px;margin-bottom:24px}.cart-title span{color:var(--grey);font-size:14px}
.cart-empty{padding:32px 0 16px;display:grid;gap:10px;justify-items:start;max-width:480px}
.btn-arrow{background:#000;color:#fff;display:inline-flex;justify-content:space-between;align-items:center;gap:32px;text-align:left;border-color:#000}
.btn-arrow i{font-style:normal;font-size:18px}.btn-arrow:hover{background:var(--volt);color:#000}
.cart-grid{display:grid;gap:32px}@media(min-width:1000px){.cart-grid{grid-template-columns:1fr 380px;align-items:start}}
.ship-bar{background:var(--concrete);padding:14px 16px;margin-bottom:16px;font-size:14px}
.bar{height:4px;background:#ddd;margin-top:8px}.bar i{display:block;height:100%;background:#000}
.cart-item{display:grid;grid-template-columns:120px 1fr;gap:16px;padding:20px 0;border-bottom:1px solid var(--line)}
@media(min-width:600px){.cart-item{grid-template-columns:180px 1fr;gap:24px}}
.ci-img{position:relative;aspect-ratio:1/1.1;background:var(--concrete)}.ci-img img{object-fit:cover}
.ci-top{display:flex;justify-content:space-between;gap:16px}.ci-top h3{font-family:var(--label);font-weight:800;font-size:15px;text-transform:none;letter-spacing:0;line-height:1.3;margin-bottom:4px}
.ci-meta{font-size:14px;margin-top:10px;color:#444}
.ci-price{text-align:right;display:grid;gap:2px;align-content:start}.ci-price b{font-size:18px}.ci-price small{font-size:11px;color:var(--grey)}.ci-price s{font-size:12px;color:var(--grey)}
.ci-actions{display:flex;align-items:flex-end;gap:20px;margin:16px 0 10px}
.ci-qty span{display:block;font-family:var(--label);font-weight:800;font-size:10px;letter-spacing:.1em;margin-bottom:4px}
.ci-qty select{height:44px;min-width:84px;border:1px solid #000;padding:0 10px;font:inherit;background:#fff}
.ci-remove{font-size:13px;text-decoration:underline;color:#444}.ci-remove:hover{color:var(--red)}
.cart-sum{background:var(--concrete);padding:24px;display:grid;gap:12px;position:sticky;top:130px}
.cart-sum h2{font-size:28px}.cs-row{display:flex;justify-content:space-between;font-size:14px}
.cs-total{display:flex;justify-content:space-between;align-items:baseline;border-top:1px solid #000;padding-top:12px;font-family:var(--label);font-weight:800;letter-spacing:.08em}.cs-total b{font-size:22px;letter-spacing:-.02em}
.cs-pay small{font-family:var(--label);font-weight:800;font-size:10px;letter-spacing:.1em}.cs-pay div{display:flex;flex-wrap:wrap;gap:6px;margin-top:6px}
.cs-pay span{border:1px solid #bbb;background:#fff;font-size:10px;font-weight:700;padding:3px 8px;font-family:var(--label)}
.cs-perks{list-style:none;font-size:13px;display:grid;gap:6px;color:#444;border-top:1px solid var(--line);padding-top:12px}.cs-perks li::before{content:"✓ ";font-weight:800}
/* voucher */
.voucher{background:#fff;border:1px dashed #000;padding:14px;margin-bottom:16px;display:grid;gap:10px}.voucher>b{font-family:var(--label);font-size:11px;letter-spacing:.1em}
.v-row{display:flex;gap:8px}.v-row input{flex:1;height:44px;border:1px solid #000;padding:0 12px;font:inherit;text-transform:uppercase}.v-row input:focus{outline:0;border-width:2px}
.v-row .btn{padding:0 18px;font-size:12px}
.v-err{color:var(--red);font-size:12px;font-style:normal}.v-ok{color:#1c6b00;font-size:13px;font-weight:600}.v-ok button{text-decoration:underline;color:#444;font-weight:400}
.v-list{display:grid;gap:8px}
.v-card{display:grid;grid-template-columns:auto 1fr;gap:2px 10px;text-align:left;border:1px solid var(--line);background:var(--concrete);padding:10px 12px}
.v-card b{font-family:var(--label);font-size:12px;background:var(--volt);padding:2px 8px;grid-row:span 2;align-self:center}.v-card span{font-weight:700;font-size:13px}.v-card small{color:var(--grey);font-size:11px}
.v-card:hover,.v-card.on{border-color:#000}.v-card.on{background:#fbffd9}
.sum-line.disc{color:#1c6b00}
.cs-voucher{font-size:12px;background:#fbffd9;padding:8px 10px;border-left:3px solid var(--volt)}
/* compact footer */
.footer{padding-top:20px}
.footer .logo{font-size:22px;margin-bottom:6px;gap:6px}.footer .stripes i{width:4px;height:14px}.footer .stripes i:nth-child(2){height:18px}.footer .stripes i:nth-child(3){height:22px}
.footer p,.footer .fgrid>div>span,.footer a{font-size:12px;margin-bottom:3px;line-height:1.4}
.footer h4{font-size:11px;margin-bottom:8px}
.fgrid{gap:16px}
.copy{margin-top:12px;padding-top:8px;padding-bottom:10px;font-size:11px}
/* big hero banner */
.big-hero{position:relative;min-height:clamp(520px,82vh,760px);color:#fff;display:flex;align-items:center;overflow:hidden;background:#222}
.big-hero>img{object-fit:cover;object-position:center 30%}
.bh-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.62) 0%,rgba(0,0,0,.34) 42%,rgba(0,0,0,0) 78%)}
.bh-inner{position:relative;z-index:1;width:100%;display:grid;gap:32px;align-items:center;padding-top:48px;padding-bottom:48px}
@media(min-width:1000px){.bh-inner{grid-template-columns:1.4fr 360px}}
.bh-tag{display:inline-block;font-family:var(--label);font-weight:800;font-size:11px;letter-spacing:.14em;background:var(--volt);color:#000;padding:5px 10px}
.bh-text h1{font-size:clamp(52px,8vw,120px);line-height:.92;margin:18px 0 16px}.bh-text h1 span{color:var(--volt)}
.bh-text p{max-width:520px;font-size:16px;color:#eee}
.bh-stats{display:flex;gap:32px;margin:24px 0 28px}.bh-stats b{display:block;font-family:var(--label);font-weight:800;font-size:24px}.bh-stats span{font-size:12px;color:#ccc}
.big-hero .btn-outline.light{border-color:#fff;color:#fff}.big-hero .btn-outline.light:hover{background:#fff;color:#000}
.big-hero .hero-cta .btn{padding:18px 34px}
.bh-card{display:grid;gap:12px}
.bh-offers{background:rgba(0,0,0,.65);border:1px solid rgba(255,255,255,.2);border-radius:14px;padding:20px;display:grid;gap:12px}
.bh-offers small{font-family:var(--label);font-weight:800;font-size:10px;letter-spacing:.16em;color:var(--volt)}
.bh-offers div{display:flex;justify-content:space-between;align-items:center;font-size:14px}.bh-offers em{font-style:normal;background:var(--volt);color:#000;font-size:11px;font-weight:700;padding:2px 10px;border-radius:999px}
.bh-offers a{font-size:13px;color:var(--volt)}.bh-offers a:hover{text-decoration:underline}
.bh-fast{background:var(--volt);color:#000;border-radius:14px;padding:16px 20px;font-family:var(--label);font-weight:800;font-size:12px;letter-spacing:.12em;display:flex;align-items:center;gap:10px}.bh-fast b{font-size:32px;letter-spacing:-.02em}
.home{padding-top:24px}
.v-rec{display:grid;gap:8px;background:#fbffd9;border:1px solid var(--volt);padding:12px}
.v-rec b{display:block;font-family:var(--label);font-size:11px;letter-spacing:.08em}.v-rec span{font-size:13px}.v-rec em{font-style:normal;font-weight:800;color:#1c6b00}
.v-rec .btn{padding:10px;font-size:12px}.v-rec .btn:disabled{opacity:.5;cursor:default}
.v-best{font-style:normal;background:#000;color:var(--volt);font-family:var(--label);font-size:9px;letter-spacing:.08em;padding:2px 6px;margin-left:8px;vertical-align:middle}
.v-card.locked{opacity:.55;border-style:dashed;cursor:not-allowed}.v-card.locked b{background:#ddd}
/* success */
.sms-note{max-width:560px;margin:0 auto 16px;padding:12px 16px;background:#fbffd9;border-left:4px solid var(--volt);font-size:14px;text-align:left}
.sms-note small{display:block;color:#555;margin-top:2px}.sms-note.failed{background:#ffeaea;border-color:var(--red)}
.success-cta{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-top:8px}
/* offers & vouchers */
.offer-link{background:var(--volt);padding:2px 8px;margin:-2px 0}
.offers-hero{background:linear-gradient(120deg,#fbffd9,#f0ff8a);border-radius:14px;padding:32px;margin-bottom:28px}
.offers-hero h1{font-family:var(--label);font-weight:800;font-size:clamp(28px,4vw,44px);text-transform:none;margin:12px 0 8px}.offers-hero p{max-width:640px;color:#333}
.vc-grid{display:grid;gap:16px}@media(min-width:800px){.vc-grid{grid-template-columns:repeat(2,1fr)}}@media(min-width:1200px){.vc-grid.four{grid-template-columns:repeat(4,1fr)}}
.vc{display:grid;grid-template-columns:110px 1fr;border:1px solid #000;border-radius:12px;overflow:hidden;background:#fff}
.vc-left{background:var(--volt);display:grid;place-content:center;text-align:center;padding:12px;border-right:2px dashed #000}
.vc-left small{font-family:var(--label);font-weight:800;font-size:10px;letter-spacing:.1em}.vc-left b{font-family:var(--display);font-size:34px;line-height:1}
.vc-body{padding:14px 16px;display:grid;gap:6px}.vc-body h3{font-family:var(--label);font-weight:800;font-size:16px;text-transform:none;letter-spacing:0}.vc-body p{font-size:13px;color:#444}
.vc-body ul{list-style:none;font-size:12px;color:#555;display:grid;gap:2px}.vc-body li::before{content:"• "}
.vc-actions{display:flex;align-items:center;gap:12px;margin-top:6px;flex-wrap:wrap}
.vc-code{display:flex;border:1px dashed #000;font-size:12px}.vc-code b{font-family:var(--label);padding:6px 10px;letter-spacing:.06em}.vc-code span{background:#000;color:var(--volt);font-family:var(--label);font-weight:800;font-size:10px;padding:6px 10px;letter-spacing:.06em;display:grid;place-items:center}
.vc-use{font-family:var(--label);font-weight:800;font-size:12px}.vc-use:hover{text-decoration:underline}
.vc.compact{grid-template-columns:84px 1fr}.vc.compact .vc-left b{font-size:26px}.vc.compact .vc-body ul li:nth-child(n+3){display:none}
.hb-offers-sec .sec-head{border-bottom:0}
.offers-note{margin-top:28px;background:var(--concrete);padding:18px 20px;font-size:14px;display:grid;gap:8px}.offers-note ul{padding-left:18px;display:grid;gap:4px}
.v-list-head{display:flex;justify-content:space-between;align-items:center;font-family:var(--label);font-size:11px;letter-spacing:.08em;margin-top:4px}.v-list-head .ul{font-size:12px}
/* choose 1 of 2 */
.choice{background:#fff;border:2px solid #000;padding:14px;margin-bottom:12px;display:grid;gap:8px}.choice>b{font-family:var(--label);font-size:11px;letter-spacing:.1em}
.ch-card{display:flex;gap:12px;align-items:center;border:1px solid var(--line);padding:12px;cursor:pointer;background:var(--concrete)}
.ch-card input{appearance:none;width:20px;height:20px;border:2px solid var(--ink);border-radius:50%!important;display:grid;place-items:center;flex:none;background:#fff}
.ch-card input:checked::after{content:"";width:10px;height:10px;background:#000;border-radius:50%!important}
.ch-card span{font-weight:700;font-size:14px}.ch-card small{display:block;color:var(--grey);font-size:12px}
.ch-card.on{border:2px solid #000;background:#fbffd9}.ch-card.off{opacity:.5;cursor:not-allowed}
.ch-clear{justify-self:start;font-size:12px;text-decoration:underline;color:#444}
/* order tracking */
.status-tabs{display:flex;gap:0;border-bottom:2px solid #000;margin:20px 0 8px;overflow-x:auto}
.st{padding:14px 20px;font-family:var(--label);font-weight:800;font-size:12px;letter-spacing:.06em;text-transform:uppercase;white-space:nowrap;display:flex;gap:8px;align-items:center;border-bottom:4px solid transparent;margin-bottom:-2px;color:#666}
.st span{background:var(--concrete);border:1px solid var(--line);min-width:22px;height:22px;display:grid;place-items:center;font-size:11px;color:#000}
.st:hover{color:#000}.st.on{color:#000;border-bottom-color:var(--volt);background:#fbffd9}.st.on span{background:#000;color:var(--volt);border-color:#000}
.badge.st-processed{background:#fff3b0;color:#000}.badge.st-shipping{background:#cfe8ff;color:#000}.badge.st-delivered{background:#000;color:var(--volt)}
.stepper{list-style:none;display:grid;grid-template-columns:repeat(3,1fr);margin:12px 0 16px;gap:0}
.stepper li{position:relative;text-align:center;font-size:12px;color:#888;display:grid;justify-items:center;gap:6px}
.stepper li::before{content:"";position:absolute;top:13px;left:-50%;width:100%;height:3px;background:#ddd;z-index:0}.stepper li:first-child::before{display:none}
.stepper li i{position:relative;z-index:1;width:28px;height:28px;border-radius:50%!important;background:#ddd;color:#555;font-style:normal;font-weight:800;font-size:12px;display:grid;place-items:center}
.stepper li.done i,.stepper li.now i{background:#000;color:var(--volt)}.stepper li.done::before,.stepper li.now::before{background:#000}
.stepper li.now{color:#000;font-weight:700}.stepper li.now i{box-shadow:0 0 0 4px var(--volt)}.stepper li.done{color:#000}
/* cancel order */
.btn-red{background:var(--red);color:#fff;border-color:var(--red)}.btn-red:hover{background:#fff;color:var(--red)}
.cancel-btn{margin-top:12px;border:1px solid var(--red);color:var(--red);padding:10px 18px;font-family:var(--label);font-weight:800;font-size:12px;letter-spacing:.06em;text-transform:uppercase}
.cancel-btn:hover{background:var(--red);color:#fff}.cancel-hint{margin-top:10px}
.badge.st-cancelled{background:var(--red);color:#fff}.st.cancelled.on{border-bottom-color:var(--red);background:#ffeaea}
.cancel-box{background:#fff7f7;border-left:4px solid var(--red);padding:14px 16px;margin:12px 0;display:grid;gap:10px}
.stepper.cancel li.done i,.stepper.cancel li.now i{background:var(--red);color:#fff}.stepper.cancel li.now i{box-shadow:0 0 0 4px #ffd0d0}.stepper.cancel li.done::before,.stepper.cancel li.now::before{background:var(--red)}
.stepper.cancel{grid-template-columns:repeat(auto-fit,minmax(0,1fr))}
.refund-info{background:#fbffd9;border-left:4px solid var(--volt);padding:10px 12px;font-size:13px}.refund-info.ok{background:#e9ffe0;border-color:#3bb800}
.modal-wrap{position:fixed;inset:0;z-index:100;display:grid;place-items:center;padding:16px}
.modal-bg{position:absolute;inset:0;background:rgba(0,0,0,.6)}
.modal{position:relative;background:#fff;width:min(520px,100%);max-height:92vh;overflow:auto;padding:24px;display:grid;gap:12px;border:2px solid #000}
.modal h3{font-size:28px}.reasons{display:grid;gap:6px}.reasons .radio{margin:0;padding:10px 12px}.reasons .radio.on{border:2px solid #000;background:#fbffd9}
.modal-actions{display:flex;gap:10px;justify-content:flex-end;flex-wrap:wrap}.modal-actions .btn{padding:12px 18px;font-size:12px}
/* reviews */
.stars{position:relative;display:inline-block;line-height:1;letter-spacing:2px;vertical-align:middle}
.stars-bg{color:#d9d9d9}.stars-fg{position:absolute;left:0;top:0;overflow:hidden;white-space:nowrap;color:#f5a800}
.rating{display:flex;align-items:center;gap:6px;font-size:13px}.rating span:last-child{color:var(--grey)}
.rv-summary{display:flex;gap:24px;align-items:center;flex-wrap:wrap;background:var(--concrete);padding:16px 20px;margin-bottom:16px}
.rv-score{display:grid;gap:2px;justify-items:center}.rv-score b{font-family:var(--display);font-size:48px;line-height:1}.rv-score small{color:var(--grey)}
.rv-list{display:grid;gap:12px}.rv{border:1px solid var(--line);padding:14px 16px;display:grid;gap:6px}.rv-head{display:flex;gap:10px;align-items:center;flex-wrap:wrap}.rv-head small{color:var(--grey);margin-left:auto}
.item-row{flex-wrap:wrap}.review-btn{border:1px solid #000;padding:6px 14px;font-family:var(--label);font-weight:800;font-size:11px;letter-spacing:.06em;margin-left:auto}.review-btn:hover{background:var(--volt)}
.reviewed{font-size:12px;color:#444;margin-left:auto;display:flex;align-items:center;gap:6px}
.rv-prod{display:flex;gap:12px;align-items:center;font-size:14px}
.star-pick{display:flex;align-items:center;gap:4px}.star-pick button{font-size:34px;line-height:1;color:#d9d9d9}.star-pick button.on{color:#f5a800}.star-pick span{margin-left:10px;font-weight:700;font-size:14px}
/* search popover */
.search{position:relative}
.search-pop{position:absolute;top:calc(100% + 6px);right:0;width:min(420px,92vw);background:#fff;border:1px solid #000;z-index:60;padding:12px;display:grid;gap:6px;max-height:70vh;overflow:auto}
.sp-title{font-family:var(--label);font-weight:800;font-size:10px;letter-spacing:.12em;color:var(--grey);margin-top:4px}
.sp-cats{display:flex;flex-wrap:wrap;gap:6px}.sp-cats button{border:1px solid var(--line);padding:6px 12px;font-family:var(--label);font-weight:800;font-size:11px;text-transform:uppercase;letter-spacing:.05em}.sp-cats button:hover{background:var(--volt);border-color:#000}
.sp-item{display:grid;grid-template-columns:44px 1fr auto;gap:10px;align-items:center;padding:6px;border-bottom:1px solid var(--line)}.sp-item:hover{background:var(--concrete)}
.sp-img{position:relative;width:44px;height:52px;background:var(--concrete)}.sp-img img{object-fit:cover}
.sp-name{font-size:13px;font-weight:600;line-height:1.25}.sp-name small{display:block;color:var(--grey);font-weight:400;font-size:11px}
.sp-item .price{font-size:12px}.sp-empty{font-size:13px;color:var(--grey);padding:8px 0}
.sp-all{font-family:var(--label);font-weight:800;font-size:12px;padding:10px;background:#000;color:var(--volt)}
/* product spec (length / thickness) */
.sp-item{grid-template-columns:44px 1fr}
.card-spec{position:absolute;left:0;right:0;bottom:0;z-index:3;display:flex;align-items:center;justify-content:center;gap:8px;background:rgba(0,0,0,.82);color:#fff;font-family:var(--label);font-weight:800;font-size:11px;letter-spacing:.08em;text-transform:uppercase;padding:9px 8px;transform:translateY(100%);transition:transform .15s linear}
.card:hover .card-spec{transform:none}
@media(hover:none){.card-spec{transform:none}}
.card-spec i{font-style:normal;opacity:.5}
.thick{display:inline-flex;gap:3px;align-items:flex-end;margin-left:4px}.thick u{display:block;width:6px;background:#777;height:8px;text-decoration:none}.thick u:nth-child(2){height:12px}.thick u:nth-child(3){height:16px}
.thick[data-t="1"] u:nth-child(1),.thick[data-t="2"] u:nth-child(-n+2),.thick[data-t="3"] u{background:var(--volt)}
.spec-row{display:flex;gap:12px;margin:0 0 20px}.spec-row>div{border:1px solid var(--line);background:var(--concrete);padding:10px 16px;display:grid;gap:2px;min-width:130px;position:relative}
.spec-row small{font-family:var(--label);font-weight:800;font-size:10px;letter-spacing:.1em;color:var(--grey)}.spec-row b{font-size:15px}
.spec-row .thick{position:absolute;right:12px;bottom:10px}.spec-row .thick u{background:#ccc}
.spec-row .thick[data-t="1"] u:nth-child(1),.spec-row .thick[data-t="2"] u:nth-child(-n+2),.spec-row .thick[data-t="3"] u{background:#000}
/* mega menu (adidas-style) */
.links a.hot{box-shadow:0 2px 0 #000}
.mega{position:absolute;left:0;right:0;top:100%;background:#fff;border-top:1px solid var(--line);border-bottom:1px solid #000;z-index:35;display:none;box-shadow:0 12px 24px rgba(0,0,0,.08)}
@media(min-width:901px){.mega{display:block}}
.mega-in{display:grid;grid-template-columns:1fr auto;gap:32px;padding-top:28px;padding-bottom:28px}
.mega-cols{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:24px;align-content:start}
.mega-col{display:grid;gap:9px;align-content:start}
.mega-col h4{font-family:var(--label);font-weight:800;font-size:12px;letter-spacing:.06em;margin-bottom:4px}
.mega-col a{font-size:13px;color:#333;line-height:1.3}.mega-col a:hover{color:#000;text-decoration:underline}
.mega-feats{display:flex;gap:0;border-left:1px solid var(--line)}
.mega-feat{width:210px;display:grid;gap:6px;align-content:start;padding:0 0 4px;border-right:1px solid var(--line);font-size:12px}
.mega-feat:hover b{text-decoration:underline}
.mega-feat-img{position:relative;aspect-ratio:1/1.25;background:var(--concrete);overflow:hidden}.mega-feat-img img{object-fit:cover}
.mega-feat b{font-family:var(--label);font-size:12px;text-transform:uppercase;padding:8px 12px 0;line-height:1.3}.mega-feat small{padding:0 12px 8px;color:#555;line-height:1.4}
.mega-foot{border-top:1px solid var(--line);background:#fff}.mega-foot .container{display:flex;gap:40px;padding-top:12px;padding-bottom:12px}
.mega-foot a{font-family:var(--label);font-weight:700;font-size:12px}.mega-foot a:hover{text-decoration:underline}
.mega-vouchers{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px;padding-top:20px;padding-bottom:20px}
.mega-vouchers a{border:1px dashed #000;padding:12px;display:grid;gap:2px;align-content:start}.mega-vouchers a:hover{background:#fbffd9}
.mega-vouchers b{font-family:var(--label);font-size:12px;background:var(--volt);justify-self:start;padding:2px 8px}.mega-vouchers span{font-weight:700;font-size:14px;margin-top:4px}.mega-vouchers small{color:var(--grey);font-size:11px}
.mega-vouchers .mega-more{background:#000;color:var(--volt);font-family:var(--label);font-weight:800;font-size:12px;place-content:center;text-align:center;border-style:solid}
/* admin */
.admin{display:grid;min-height:100vh;background:#f4f5f1}@media(min-width:900px){.admin{grid-template-columns:230px 1fr}}
.admin-side{background:#000;color:#fff;padding:20px;display:flex;flex-direction:column;gap:6px}@media(min-width:900px){.admin-side{position:sticky;top:0;height:100vh}}
.admin-side .logo{color:#fff;font-size:26px;margin-bottom:0}.admin-side small{font-family:var(--label);font-weight:800;font-size:10px;letter-spacing:.16em;color:var(--volt);margin:2px 0 14px}
.admin-side nav{display:flex;flex-direction:column;gap:2px}@media(max-width:899px){.admin-side nav{flex-direction:row;flex-wrap:wrap}}
.admin-side nav a{padding:10px 12px;font-family:var(--label);font-weight:700;font-size:13px;color:#ccc}.admin-side nav a:hover{background:#222;color:#fff}.admin-side nav a.on{background:var(--volt);color:#000}
.admin-back{margin-top:auto;font-size:12px;color:#aaa;padding:10px 12px}.admin-back:hover{color:#fff}
.admin-main{padding:24px;min-width:0;display:grid;gap:16px;align-content:start}
.stats{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:12px}
.stat{background:#fff;border:1px solid var(--line);padding:16px;display:grid;gap:4px}.stat small{font-family:var(--label);font-weight:800;font-size:10px;letter-spacing:.08em;color:var(--grey)}
.stat b{font-family:var(--label);font-size:24px;letter-spacing:-.02em}.stat span{font-size:12px;color:var(--grey)}.stat.warn{border-color:var(--red);background:#fff7f7}.stat.warn span{color:var(--red);font-weight:700}
.admin-grid{display:grid;gap:16px}@media(min-width:1000px){.admin-grid{grid-template-columns:1fr 1fr}}
.panel{background:#fff;border:1px solid var(--line);padding:18px;display:grid;gap:10px;align-content:start}.panel h3{font-size:24px}.panel-head{display:flex;justify-content:space-between;align-items:baseline}
.bar-row{display:grid;grid-template-columns:130px 1fr 32px;gap:10px;align-items:center;font-size:13px}.bar-row>div{background:#eee;height:10px}.bar-row i{display:block;height:100%;background:#000}.bar-row i.red{background:var(--red)}.bar-row b{text-align:right}
.top-row{display:flex;justify-content:space-between;gap:12px;font-size:13px;padding:6px 0;border-bottom:1px solid var(--line)}
.mini-order{display:grid;grid-template-columns:110px 1fr auto auto;gap:12px;font-size:13px;padding:8px 0;border-bottom:1px solid var(--line)}
.admin-bar{display:grid;gap:10px}.admin-search{height:44px;border:1px solid #000;padding:0 12px;font:inherit;max-width:420px}
.admin-order{background:#fff;margin-top:0;display:grid;gap:8px}.order-head .right{margin-left:auto}
.admin-actions{display:flex;gap:8px;margin-top:4px}.btn.sm{padding:10px 16px;font-size:11px}
.late{color:var(--red)}.cancel-btn.sm{padding:6px 12px;font-size:11px}
.table{background:#fff;border:1px solid var(--line);overflow-x:auto}
.tr{display:grid;grid-template-columns:1.2fr 1.4fr .6fr .8fr;gap:12px;padding:12px 16px;border-bottom:1px solid var(--line);font-size:13px;align-items:center;min-width:560px}
.tr.th{background:#000;color:var(--volt);font-family:var(--label);font-weight:800;font-size:11px;letter-spacing:.06em;text-transform:uppercase}
.table.prod .tr{grid-template-columns:2.2fr 1.4fr 1.1fr 1.3fr .5fr;min-width:760px}.table.vch .tr{grid-template-columns:.9fr 1.2fr 2fr .6fr}
.cellp{display:flex;align-items:center;gap:10px;flex-wrap:wrap}.cellp .sum-img{width:44px;height:52px}
.sz{display:inline-block;border:1px solid var(--line);padding:1px 6px;margin:0 3px 3px 0;font-size:11px}.sz.out{color:#aaa;text-decoration:line-through}
.code{font-family:var(--label);background:var(--volt);padding:2px 8px;font-size:12px}
code{background:#eee;padding:1px 5px;font-size:12px}
/* revenue */
.rev-controls{display:flex;gap:16px;align-items:center;flex-wrap:wrap}
.seg{display:inline-flex;border:2px solid #000;background:#fff}.seg button{padding:10px 22px;font-family:var(--label);font-weight:800;font-size:12px;letter-spacing:.06em;text-transform:uppercase}
.seg button+button{border-left:1px solid #000}.seg button.on{background:var(--volt)}.seg button:not(.on):hover{background:var(--concrete)}
.chk{display:flex;gap:8px;align-items:center;font-size:13px;cursor:pointer}.chk input{width:16px;height:16px;accent-color:#000}
.up{color:#1c6b00!important;font-weight:700}.down{color:var(--red)!important;font-weight:700}
.chart{display:flex;align-items:flex-end;gap:6px;height:280px;overflow-x:auto;padding:4px 0 0}
.chart .col{flex:1;min-width:34px;height:100%;display:grid;grid-template-rows:16px 1fr auto;gap:4px;justify-items:center}
.chart .val{font-size:10px;font-weight:700;color:#444;white-space:nowrap}
.chart .bar{width:100%;max-width:44px;display:flex;align-items:flex-end;background:repeating-linear-gradient(to top,#f1f1f1 0 1px,transparent 1px 25%)}
.chart .bar i{display:block;width:100%;background:var(--volt);border:1px solid #000;min-height:0}.chart .bar i[style*="height: 0%"]{border:0}.chart .bar i.now{background:#000}
.chart small{font-size:10px;color:#555;text-align:center;line-height:1.2;white-space:nowrap}
.table.rev .tr{grid-template-columns:1.2fr .6fr 1fr 1fr;min-width:520px}
.rev-sub{font-family:var(--label);font-weight:800;font-size:13px;letter-spacing:.1em;margin-top:12px}
@media(min-width:1200px){.admin-grid.three{grid-template-columns:repeat(3,1fr)}}
.admin-grid.three .chart{height:200px}.admin-grid.three .table.rev .tr{grid-template-columns:1fr .5fr 1fr 1fr;min-width:0;font-size:12px;padding:8px 10px}
.admin-grid.three .table.rev{max-height:260px;overflow:auto}
/* review photos */
.photo-pick{display:grid;gap:6px}.photo-pick>span{font-family:var(--label);font-weight:800;font-size:11px;letter-spacing:.1em}
.photo-row{display:flex;gap:8px;flex-wrap:wrap}
.photo{position:relative;width:84px;height:84px;border:1px solid var(--line);background:var(--concrete);overflow:hidden}.photo img{width:100%;height:100%;object-fit:cover}
.photo button{position:absolute;top:2px;right:2px;width:20px;height:20px;background:#000;color:#fff;font-size:11px;line-height:1}
.photo.add{display:grid;place-items:center;border:2px dashed #000;font-size:12px;font-weight:700;cursor:pointer;background:#fff}.photo.add:hover{background:var(--volt)}
.rv-imgs{display:flex;gap:8px;flex-wrap:wrap;margin-top:4px}.rv-imgs button{width:84px;height:84px;border:1px solid var(--line);overflow:hidden;background:var(--concrete)}.rv-imgs img{width:100%;height:100%;object-fit:cover}
.lightbox{position:fixed;inset:0;z-index:120;background:rgba(0,0,0,.85);display:grid;place-items:center;padding:20px;cursor:zoom-out}.lightbox img{max-width:min(92vw,900px);max-height:88vh;object-fit:contain}
.lightbox button{position:absolute;top:16px;right:20px;color:#fff;font-size:26px}
/* loyalty */
.loy-box{background:#fff;border:2px solid #000;padding:14px;margin-bottom:12px;display:grid;gap:8px}
.loy-head{display:flex;align-items:center;gap:8px;font-family:var(--label);font-size:12px;letter-spacing:.08em}.loy-head small{color:var(--grey);margin-left:auto;font-family:var(--body);letter-spacing:0}
.tier-dot{width:14px;height:14px;border-radius:50%!important;display:inline-block;border:1px solid #000}
.chk.off{opacity:.55;cursor:not-allowed}
.member-card{background:linear-gradient(135deg,#111,#2b2b2b);color:#fff;border-radius:16px;padding:28px;display:flex;justify-content:space-between;gap:16px;border:3px solid var(--tier,#b87333);margin:16px 0;flex-wrap:wrap}
.member-card small{font-family:var(--label);font-weight:800;font-size:11px;letter-spacing:.16em;color:var(--tier)}.member-card h2{font-size:clamp(44px,6vw,72px);color:var(--tier);line-height:1;margin:4px 0 10px}.member-card p{font-size:14px}.member-card span{color:#bbb;font-size:12px}
.mc-right{text-align:right;display:grid;align-content:end}.mc-right b{font-family:var(--display);font-size:64px;line-height:1;color:var(--volt)}.mc-right span{font-size:12px}
.prog{height:12px;background:#eee;border:1px solid #000}.prog i{display:block;height:100%}
.table.tiers .tr{grid-template-columns:1.2fr .6fr 1.4fr;min-width:0}.table.tiers .tr.cur{background:#fbffd9}
.rules{padding-left:18px;display:grid;gap:6px;font-size:14px}
.panel{margin-top:0}.container>.panel,.container>.stats{margin-bottom:16px}
.table.cust .tr{grid-template-columns:1.2fr 1.6fr .5fr 1fr 1.1fr .8fr;min-width:760px}
/* my points */
.pts-top{display:flex;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap}
.pts-hero{background:linear-gradient(135deg,#111,#2b2b2b);color:#fff;border-radius:14px;padding:24px 28px;display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;border-left:8px solid var(--tier,#b87333);margin:12px 0 16px}
.pts-hero small{font-family:var(--label);font-weight:800;font-size:11px;letter-spacing:.14em;color:var(--volt);display:block}.pts-hero b{font-family:var(--display);font-size:clamp(48px,7vw,84px);line-height:1;display:block;color:var(--volt)}.pts-hero span{font-size:13px;color:#ccc}
.pts-tier{background:#fff;color:#000;padding:10px 16px;font-size:14px;display:flex;align-items:center;gap:8px}
.pts-list{display:grid;gap:0;border:1px solid var(--line)}
.pts-row{display:grid;grid-template-columns:1fr auto 110px;gap:12px;align-items:center;padding:14px 16px;border-bottom:1px solid var(--line);background:#fff}
.pts-row b{font-size:14px}.pts-row small{display:block;color:var(--grey);font-size:12px;font-weight:400;margin-top:2px}.pts-val{text-align:right;font-family:var(--label);font-size:18px}
.pts-row.earned .pts-val,.pts-row.refund .pts-val{color:#1c6b00}.pts-row.used .pts-val{color:var(--red)}.pts-row.pending .pts-val{color:#8a6d00}.pts-row.void{opacity:.55}
.badge.pt-earned{background:#d7f7c2;color:#145200}.badge.pt-pending{background:#fff3b0}.badge.pt-used{background:#ffd9d9;color:#8a0000}.badge.pt-refund{background:#cfe8ff}.badge.pt-void{background:#eee;color:#555}
.stat.link:hover{border-color:#000;background:#fbffd9}
.pts-link{font-weight:800!important;color:#000!important;background:var(--volt);padding:1px 8px}
/* tier ladder */
.ladder{display:grid;gap:12px}@media(min-width:700px){.ladder{grid-template-columns:repeat(2,1fr)}}@media(min-width:1100px){.ladder{grid-template-columns:repeat(4,1fr)}}
.tier{background:#fff;border:2px solid var(--line);border-top:8px solid var(--tier);padding:16px;display:grid;gap:10px;align-content:start}
.tier header{display:flex;justify-content:space-between;align-items:center;gap:8px}.tier-name{font-family:var(--label);font-weight:800;font-size:15px;display:flex;align-items:center;gap:8px;text-transform:uppercase}
.tier .tick{font-style:normal;font-family:var(--label);font-weight:800;font-size:10px;color:#1c6b00}
.tier-rate{display:flex;align-items:baseline;gap:8px}.tier-rate b{font-family:var(--display);font-size:52px;line-height:1;color:#000}.tier-rate span{font-size:12px;color:var(--grey)}
.tier ul{list-style:none;display:grid;gap:6px;font-size:13px}.tier li::before{content:"• ";color:var(--tier);font-weight:800}
.tier small{font-size:12px;color:#444}.tier-prog{display:grid;gap:4px}
.tier.current{border-color:#000;background:#fbffd9;box-shadow:0 0 0 2px var(--volt)}.tier.done{background:#f7fff0}.tier.locked{opacity:.92}.tier.restore{border-style:dashed}
.ladder-panel{margin-bottom:16px}
/* image search */
.search form{position:relative}.search form input{padding-right:40px}
.cam-btn{position:absolute;right:6px;top:50%;transform:translateY(-50%);width:30px;height:30px;display:grid;place-items:center;color:#333}.cam-btn:hover{background:var(--volt)}
.photo-drop{border:2px dashed #000;padding:12px;font-size:12px;font-weight:700;text-align:center;background:#fbffd9}.photo-drop:hover{background:var(--volt)}
.ph-head{display:grid;grid-template-columns:56px 1fr auto;gap:10px;align-items:center;padding-bottom:8px;border-bottom:1px solid var(--line)}
.ph-head img{width:56px;height:56px;object-fit:cover;border:1px solid var(--line)}.ph-head b{font-family:var(--label);font-size:11px;letter-spacing:.1em;display:block}.ph-head small{color:var(--grey);font-size:11px}
.ph-head button{font-size:12px;text-decoration:underline;color:#444}
.match{font-family:var(--label);font-weight:800;font-size:12px;background:var(--concrete);padding:3px 8px}.match.top{background:var(--volt)}
/* invoice */
.inv-bar{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}.inv-bar>div{display:flex;gap:8px}
.inv{background:#fff;border:1px solid var(--line);padding:32px;max-width:820px;display:grid;gap:10px}
.inv .top{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap}.inv h1{font-family:var(--label);font-weight:800;font-size:24px;text-transform:none}
.inv .seller{text-align:right;font-size:13px;line-height:1.5}.inv-h{font-family:var(--label);font-size:12px;letter-spacing:.1em;margin-top:6px}
.inv table{width:100%;border-collapse:collapse}.inv th,.inv td{border-bottom:1px solid #ddd;padding:8px;text-align:left;font-size:13px}.inv th{background:#111;color:var(--volt);font-size:11px;text-transform:uppercase}
.inv .r{text-align:right}.inv .tot td{font-weight:800;border-top:2px solid #111;font-size:15px}
@page{margin:0}
@media print{
  .no-print,.admin-side{display:none!important}
  .admin{display:block!important;background:#fff}.admin-main{padding:16mm!important}
  .inv{border:0;padding:0;max-width:none}
  body{background:#fff}
}
/* admin product/voucher forms */
.admin-head{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
.pform,.vform{background:#fff;border:1px solid var(--line);padding:20px;display:grid;gap:4px;max-width:820px}
.pform .field small,.vform .field small{display:block;margin-top:2px}
.form-actions{display:flex;gap:10px;justify-content:flex-end;margin-top:8px}
.photo.big{width:120px;height:120px}.photo.big .x{position:absolute;top:3px;right:3px;width:22px;height:22px;background:#000;color:#fff;font-size:12px}
.photo.big .mk{position:absolute;bottom:0;left:0;right:0;background:rgba(0,0,0,.75);color:#fff;font-size:10px;padding:4px}.photo.big .main{position:absolute;bottom:4px;left:4px;margin:0}
.row-actions{display:flex;gap:12px;margin-left:auto;font-size:12px}.ul.danger{color:var(--red)}
.vform label.chk{margin:2px 0}.vform .excl{display:flex;gap:12px;flex-wrap:wrap}
/* admin order detail */
.admin-order.clickable{cursor:pointer}.admin-order.clickable:hover{border-color:#000;box-shadow:0 0 0 1px #000}
.detail-link{font-size:12px;white-space:nowrap}
.head-actions{display:flex;gap:8px}
.detail-grid{display:grid;gap:16px}@media(min-width:1100px){.detail-grid{grid-template-columns:1.4fr 1fr}}
.dt-side{display:grid;gap:16px;align-content:start}
.dt-item{display:grid;grid-template-columns:56px 1fr auto;gap:12px;align-items:center;padding:10px 0;border-bottom:1px solid var(--line);font-size:13px}
.dt-sum{display:grid;gap:6px;margin-top:6px;font-size:14px}.dt-sum>div{display:flex;justify-content:space-between}.dt-sum .disc{color:#1c6b00}
.dt-sum .grand{border-top:2px solid #000;padding-top:8px;font-family:var(--label);font-size:15px}.dt-sum .grand b{font-size:20px}
.cust{display:flex;gap:12px;align-items:center}.avatar{width:44px;height:44px;border-radius:50%!important;background:var(--volt);border:2px solid #000;display:grid;place-items:center;font-family:var(--label);font-weight:800;font-size:18px}
.kv{display:grid;grid-template-columns:130px 1fr;gap:8px 12px;font-size:13px}.kv dt{color:var(--grey)}.kv dd{margin:0}
a.mini-order:hover{background:var(--concrete)}
/* ===== admin order detail (redesign) ===== */
.od{display:grid;gap:16px}
.od-back{font-size:13px;font-weight:700;color:#444}.od-back:hover{color:#000;text-decoration:underline}
.od-hero{background:linear-gradient(135deg,#0b0b0b,#262626);color:#fff;border-radius:16px;padding:24px 28px;display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap}
.od-hero small{font-family:var(--label);font-weight:800;font-size:11px;letter-spacing:.16em;color:#aaa;display:block}
.od-hero h1{font-family:var(--display);font-size:clamp(34px,5vw,54px);color:var(--volt);line-height:1;margin:2px 0 10px;text-transform:none;letter-spacing:.02em}
.od-meta{display:flex;gap:14px;align-items:center;flex-wrap:wrap;font-size:13px;color:#ddd}
.od-total{text-align:right;display:grid;gap:4px;justify-items:end}.od-total b{font-family:var(--label);font-weight:800;font-size:clamp(26px,3.4vw,36px);letter-spacing:-.02em}
.od-invoice{margin-top:6px;background:var(--volt);color:#000;font-family:var(--label);font-weight:800;font-size:12px;padding:8px 14px;border-radius:999px}.od-invoice:hover{background:#fff}
.od-stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px}
.od-stats>div{background:#fff;border:1px solid var(--line);border-radius:14px;padding:14px 16px;display:grid;gap:2px}
.od-stats i{font-style:normal;font-size:20px}.od-stats b{font-family:var(--label);font-weight:800;font-size:18px;letter-spacing:-.01em}.od-stats small{color:var(--grey);font-size:12px}
.od-card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:20px;display:grid;gap:14px;align-content:start;box-shadow:0 1px 2px rgba(0,0,0,.04)}
.od-card h3{font-family:var(--label);font-weight:800;font-size:12px;letter-spacing:.12em;color:#555;text-transform:uppercase}
.od-cancel{border-color:var(--red);background:#fff7f7}
.od-grid{display:grid;gap:16px}@media(min-width:1180px){.od-grid{grid-template-columns:minmax(0,1.5fr) minmax(320px,1fr);align-items:start}}
.od-col{display:grid;gap:16px;align-content:start;min-width:0}
.stepper.big li{font-size:13px}.stepper.big li i{width:36px;height:36px;font-size:14px}.stepper.big li::before{top:17px;height:4px}
.od-actions{display:flex;gap:8px}
/* items */
.od-items{display:grid;gap:12px}
.od-item{display:grid;grid-template-columns:80px 1fr auto;gap:14px;align-items:center;padding:12px;background:var(--concrete);border-radius:12px}
.od-thumb{position:relative;width:80px;height:96px;background:#fff;border-radius:8px;overflow:hidden}.od-thumb img{object-fit:cover}
.od-info{display:grid;gap:6px;min-width:0}.od-info b{font-size:14px;line-height:1.3}.od-info a:hover b{text-decoration:underline}
.od-tags{display:flex;gap:6px;flex-wrap:wrap}.od-tags span{background:#fff;border:1px solid var(--line);border-radius:999px;padding:2px 10px;font-size:12px;font-weight:600}
.od-note{background:#fff3b0;border-radius:8px;padding:6px 10px;font-size:12px;font-weight:600}
.od-line{font-family:var(--label);font-size:15px;white-space:nowrap}
.dt-sum{border-top:1px dashed #bbb;padding-top:12px}
.od-other{display:grid;grid-template-columns:110px 1fr auto auto;gap:12px;align-items:center;padding:10px 12px;border-radius:10px;font-size:13px}
.od-other:hover{background:var(--concrete)}.od-other span{color:#555;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.od-other small{color:var(--grey)}
/* customer */
.cust-card{border-top:6px solid var(--tier,#b87333)}
.cust-top{display:flex;gap:14px;align-items:center}.cust-top h2{font-family:var(--label);font-weight:800;font-size:20px;text-transform:none;letter-spacing:0;margin-bottom:4px}
.avatar.lg{width:60px;height:60px;font-size:26px;flex:none}
.tier-pill{display:inline-flex;align-items:center;gap:6px;background:var(--concrete);border:1px solid var(--line);border-radius:999px;padding:3px 12px;font-size:12px;font-weight:700}
.contact{list-style:none;display:grid;gap:10px}
.contact li{display:grid;grid-template-columns:36px 1fr auto;gap:10px;align-items:center;padding:10px 12px;background:var(--concrete);border-radius:12px}
.contact li>i{font-style:normal;font-size:18px;text-align:center}.contact small{display:block;color:var(--grey);font-size:11px}.contact b{font-size:13px;line-height:1.35;word-break:break-word}
.mini-btn{background:#000;color:var(--volt);font-family:var(--label);font-weight:800;font-size:11px;padding:7px 12px;border-radius:999px;white-space:nowrap}.mini-btn:hover{background:var(--volt);color:#000;outline:1px solid #000}
.tiles3{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.tiles3>div{background:#fbffd9;border:1px solid #e6f27a;border-radius:12px;padding:12px 8px;text-align:center;display:grid;gap:2px}.tiles3 b{font-family:var(--label);font-weight:800;font-size:20px;letter-spacing:-.02em}.tiles3 small{font-size:11px;color:#555}
/* căn giữa trang chi tiết đơn hàng */
.od{width:100%;max-width:1120px;margin-left:auto;margin-right:auto}
/* ===== một khối thống nhất ===== */
.od-sheet{background:#fff;border:1px solid var(--line);border-radius:18px;overflow:hidden;box-shadow:0 8px 28px rgba(0,0,0,.08)}
.od-sheet .od-hero{border-radius:0}
.od-sheet .od-stats{gap:0;grid-template-columns:repeat(2,1fr);border-bottom:1px solid var(--line)}
@media(min-width:760px){.od-sheet .od-stats{grid-template-columns:repeat(4,1fr)}}
.od-sheet .od-stats>div{border:0;border-radius:0;border-right:1px solid var(--line);box-shadow:none;padding:16px 22px;background:#fff}
.od-sheet .od-stats>div:last-child{border-right:0}
.od-sheet .od-card{border:0;border-radius:0;box-shadow:none;border-bottom:1px solid var(--line);padding:22px 28px;background:transparent}
.od-sheet .od-cancel{background:#fff7f7;border-left:6px solid var(--red)}
.od-sheet .od-grid{gap:0;align-items:stretch}
.od-sheet .od-col{gap:0}
@media(min-width:1180px){.od-sheet .od-col:first-child{border-right:1px solid var(--line)}}
.od-sheet .od-col .od-card:last-child{border-bottom:0}
.od-sheet .od-grid{border-bottom:0}
.od-sheet .cust-card{box-shadow:inset 0 6px 0 var(--tier,#b87333);padding-top:28px;background:#fcfcf8;height:100%}
.od-sheet .od-item{background:var(--concrete)}
.od-sheet .tiles3>div{box-shadow:none}
/* chi tiết đơn hàng: full chiều rộng màn hình */
.od{max-width:none;margin-left:0;margin-right:0}
@media(min-width:1500px){.od-sheet .od-grid{grid-template-columns:minmax(0,1.6fr) minmax(380px,1fr)}.od-sheet .od-hero h1{font-size:64px}}
/* admin product detail */
.pd-gallery{display:grid;gap:10px}.pd-main{position:relative;aspect-ratio:4/3;max-height:420px;width:100%;background:var(--concrete);border-radius:12px;overflow:hidden}.pd-main img{object-fit:contain}
.pd-thumbs{display:flex;gap:8px;flex-wrap:wrap}.pd-thumbs button{position:relative;width:64px;height:64px;border:2px solid transparent;border-radius:8px;overflow:hidden;background:var(--concrete)}.pd-thumbs button.on{border-color:#000}.pd-thumbs img{object-fit:cover}
.pd-rating{display:flex;align-items:center;gap:12px}.pd-rating b{font-family:var(--display);font-size:44px;line-height:1}
.pd-sizes{display:flex;gap:6px;flex-wrap:wrap}.pd-sizes .sz{padding:5px 12px;font-size:12px;font-weight:700}
.top-row.link,.mini-order.link{border-radius:8px;padding-left:8px;padding-right:8px}.top-row.link:hover,.mini-order.link:hover{background:var(--concrete)}
/* help & stores */
.help-hero{background:linear-gradient(120deg,#fbffd9,#f0ff8a);border-radius:16px;padding:40px 32px;display:grid;gap:12px;justify-items:start}
.help-hero h1{font-family:var(--label);font-weight:800;font-size:clamp(26px,4vw,42px);text-transform:none;letter-spacing:-.01em;line-height:1.15}.help-hero p{max-width:640px;color:#333}
.help-search{width:min(640px,100%);height:52px;border:2px solid #000;border-radius:999px!important;padding:0 20px;font:inherit;background:#fff}.help-search:focus{outline:0;box-shadow:0 0 0 3px var(--volt)}
.help-channels{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:12px;margin-top:16px}
.channel{display:flex;gap:14px;align-items:center;border:1px solid var(--line);border-radius:14px;padding:18px;background:#fff}.channel:hover{border-color:#000;box-shadow:0 0 0 1px #000}
.channel>i{font-style:normal;font-size:28px}.channel small{display:block;font-family:var(--label);font-weight:800;font-size:10px;letter-spacing:.12em;color:var(--grey)}.channel b{display:block;font-size:16px}.channel span{font-size:12px;color:#555}
.topic-chips{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px}
.faq.wide{display:grid;gap:10px}@media(min-width:1000px){.faq.wide{grid-template-columns:1fr 1fr;align-items:start}}
.faq.wide details{border-radius:12px;background:#fff;padding:16px 18px}.faq.wide summary{display:flex;gap:10px;align-items:center}.faq-tag{font-size:18px}
.help-cta{margin-top:28px;background:#000;color:#fff;border-radius:16px;padding:28px 32px;display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap}
.help-cta h3{font-size:30px;color:var(--volt)}.help-cta p{color:#ccc;max-width:520px;margin-top:4px}.help-cta-btns{display:flex;gap:10px;flex-wrap:wrap}
.help-cta .btn-black{background:var(--volt);color:#000;border-color:var(--volt)}.help-cta .btn-outline{color:#fff;border-color:#fff}.help-cta .btn-outline:hover{background:#fff;color:#000}
.store-grid{display:grid;gap:14px}@media(min-width:760px){.store-grid{grid-template-columns:repeat(2,1fr)}}@media(min-width:1200px){.store-grid{grid-template-columns:repeat(3,1fr)}}
.store-card{border:1px solid var(--line);border-radius:14px;padding:20px;background:#fff;display:grid;gap:12px;align-content:start}.store-card:hover{border-color:#000}
.store-card header{display:flex;justify-content:space-between;align-items:center;gap:8px}.store-card h3{font-size:26px}
.store-card ul{list-style:none;display:grid;gap:8px;font-size:13px}.store-card li{display:grid;grid-template-columns:22px 1fr;gap:6px}.store-card li i{font-style:normal}
.svc{display:flex;gap:6px;flex-wrap:wrap}.svc span{background:var(--concrete);border:1px solid var(--line);border-radius:999px;padding:3px 10px;font-size:11px;font-weight:600}
.store-actions{display:flex;gap:8px;flex-wrap:wrap}.store-actions .btn{padding:10px 16px;font-size:11px}
/* orders page extras */
.ot-stats{margin:16px 0 12px}.ot-search{width:100%;max-width:none;margin-bottom:8px;border-radius:999px!important;padding:0 20px}
.order-foot{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-top:12px}.order-foot .cancel-btn{margin-top:0}
.reorder-btn{border:1px solid #000;padding:10px 18px;font-family:var(--label);font-weight:800;font-size:12px;letter-spacing:.04em;text-transform:uppercase}.reorder-btn:hover{background:var(--volt)}
.ot-help{margin-top:20px;background:#000;color:#fff;border-radius:16px;padding:24px 28px;display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap}
.ot-help h3{font-size:28px;color:var(--volt)}.ot-help p{color:#ccc;max-width:520px;margin-top:4px;font-size:14px}
.ot-help .btn-black{background:var(--volt);color:#000;border-color:var(--volt)}.ot-help .btn-outline{color:#fff;border-color:#fff}.ot-help .btn-outline:hover{background:#fff;color:#000}
/* hero carousel */
.big-hero.carousel{display:block;padding:0}
.bh-slide{position:absolute;inset:0;display:flex;align-items:center;opacity:0;visibility:hidden;transition:opacity .9s ease,visibility .9s;pointer-events:none}
.bh-slide.on{opacity:1;visibility:visible;z-index:1;pointer-events:auto}
.bh-slide>img{object-fit:cover;object-position:center 30%;transform:scale(1)}
.bh-slide.on>img{animation:none}
@keyframes bhzoom{from{transform:scale(1)}to{transform:scale(1.09)}}
.bh-slide .bh-inner{position:relative}
.bh-slide.on .bh-text>*{animation:bhup .8s cubic-bezier(.2,.7,.2,1) both}
.bh-slide.on .bh-text>*:nth-child(2){animation-delay:.12s}.bh-slide.on .bh-text>*:nth-child(3){animation-delay:.24s}.bh-slide.on .bh-text>*:nth-child(4){animation-delay:.36s}
.bh-slide.on .bh-card{animation:bhin .9s .3s both}
@keyframes bhup{from{opacity:0;transform:translateY(26px)}to{opacity:1;transform:none}}
@keyframes bhin{from{opacity:0;transform:translateX(30px)}to{opacity:1;transform:none}}
.carousel{min-height:clamp(560px,84vh,780px)}
.bh-arrow{position:absolute;top:50%;transform:translateY(-50%);z-index:5;width:52px;height:52px;border-radius:50%!important;background:rgba(0,0,0,.45);color:#fff;font-size:34px;line-height:1;display:grid;place-items:center;border:1px solid rgba(255,255,255,.4);padding-bottom:4px}
.bh-arrow:hover{background:var(--volt);color:#000;border-color:#000}.bh-arrow.prev{left:16px}.bh-arrow.next{right:16px}
@media(max-width:700px){.bh-arrow{display:none}}
.bh-dots{position:absolute;left:50%;bottom:22px;transform:translateX(-50%);z-index:5;display:flex;gap:10px}
.bh-dots button{position:relative;width:46px;height:5px;background:rgba(255,255,255,.4);overflow:hidden}.bh-dots button:hover{background:rgba(255,255,255,.7)}
.bh-dots button i{position:absolute;inset:0;width:0;background:var(--volt)}
.bh-dots button.on i{animation-name:bhprog;animation-timing-function:linear;animation-fill-mode:forwards;animation-duration:5500ms}
.bh-dots button.on:not(:has(i[style])) i{width:100%;animation:none}
@keyframes bhprog{from{width:0}to{width:100%}}
@media(prefers-reduced-motion:reduce){.bh-slide,.bh-slide.on>img,.bh-slide.on .bh-text>*,.bh-slide.on .bh-card{animation:none;transition:none}}
/* menu không xuống dòng */
.links a{white-space:nowrap}
@media(min-width:901px) and (max-width:1250px){.links{gap:14px;margin-left:8px}.search input{width:150px}.nav{gap:14px}}
/* admin customers */
.cust-filters{gap:12px}.cf-row{display:flex;gap:20px;flex-wrap:wrap;align-items:flex-start}.cf-group{display:grid;gap:6px}.cf-group>small{font-family:var(--label);font-weight:800;font-size:10px;letter-spacing:.12em;color:var(--grey)}
.cf-group .topic-chips{margin-bottom:0}.cf-sort{height:40px;border:1px solid #000;padding:0 12px;font:inherit;background:#fff}
.table.cust2 .tr{grid-template-columns:1.7fr 1.5fr 1.1fr .7fr .9fr .9fr 1fr;min-width:980px;padding:14px 16px}
.table.cust2 .tr>span{display:grid;gap:2px;align-content:center}.table.cust2 small{font-size:11px}.table.cust2 .tr.th>span{display:block}
.table.cust2 .tr.click{cursor:pointer}.table.cust2 .tr.click:hover{background:#fbffd9}
.who{grid-template-columns:40px 1fr!important;gap:10px!important;align-items:center}.who .avatar{width:38px;height:38px;font-size:15px}
.addr{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:230px;display:block}
.cs{font-style:normal;font-family:var(--label);font-weight:800;font-size:10px;letter-spacing:.04em;text-transform:uppercase;padding:4px 10px;border-radius:999px;white-space:nowrap;justify-self:start}
.cs-new{background:#eee;color:#555}.cs-active{background:#d7f7c2;color:#145200}.cs-risk{background:#fff3b0;color:#6b5200}.cs-lapsed{background:#ffd9d9;color:#8a0000}
.tier-pill.dark{background:#fff;color:#000}
.hist{display:grid;grid-template-columns:130px 1fr auto auto;gap:12px;align-items:center;padding:12px;border-bottom:1px solid var(--line);font-size:13px;border-radius:8px}.hist:hover{background:var(--concrete)}
.hist>div{display:grid}.hist-items{color:#555;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.table.cust2 .who>span:last-child{display:grid;gap:2px;min-width:0}.table.cust2 .who small{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
/* banner full màn hình */
.carousel{min-height:560px!important;max-height:none!important}
.carousel .bh-text h1{font-size:clamp(56px,9vw,150px)}
.carousel .bh-text p{font-size:clamp(16px,1.4vw,20px);max-width:620px}
.carousel .hero-cta .btn{padding:20px 40px;font-size:14px}
.carousel .bh-inner{max-width:1700px}
@media(min-width:1000px){.carousel .bh-inner{grid-template-columns:1.5fr 400px}}
.bh-dots{bottom:30px}
/* home: nhiều sản phẩm hơn */
.grid.five{grid-template-columns:repeat(2,1fr)}
@media(min-width:760px){.grid.five{grid-template-columns:repeat(3,1fr)}}
@media(min-width:1000px){.grid.five{grid-template-columns:repeat(4,1fr)}}
@media(min-width:1300px){.grid.five{grid-template-columns:repeat(5,1fr)}}
.grid.five .card{border-radius:10px;overflow:hidden}
.showcase .sec-head,.prow .sec-head{border-bottom:0}
.show-more{display:flex;justify-content:center;padding:24px 0 4px}
.prow-note{margin:-12px 0 12px}
/* nền chờ khi ảnh đang tải (hiệu ứng lướt sáng) */
@keyframes shimmer{to{background-position:-200% 0}}
.card-img,.sum-img,.line-img,.od-thumb,.sp-img,.mega-feat-img,.gallery-main,.ci-img,.pay-thumb,.thumb,.mini,.pd-main{background:linear-gradient(110deg,#efefe8 8%,#fafaf5 18%,#efefe8 33%);background-size:200% 100%;animation:shimmer 1.3s linear infinite}
.card-img img,.sum-img img,.line-img img,.od-thumb img,.sp-img img,.mega-feat-img img,.gallery-main img,.ci-img img,.pay-thumb img,.thumb img,.mini img,.pd-main img{background:#fff}
@media(prefers-reduced-motion:reduce){.card-img,.sum-img,.line-img,.od-thumb,.sp-img,.mega-feat-img,.gallery-main,.ci-img,.pay-thumb,.thumb,.mini,.pd-main{animation:none}}
/* admin: nút về cửa hàng nổi bật ở đầu menu, không bị che bởi nút dev của Next */
.admin-store{display:block;background:var(--volt);color:#000;font-family:var(--label);font-weight:800;font-size:12px;letter-spacing:.04em;padding:11px 12px;margin:2px 0 14px;text-align:center}
.admin-store:hover{background:#fff}
.admin-back{margin-bottom:64px}
@media(max-width:899px){.admin-back{margin-bottom:0}}
/* nhóm danh mục & bảng màu */
.filters.sub{margin-top:-8px}.chip.sm{padding:6px 12px;font-size:11px}
.swatches{display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin:4px 0 20px;padding:12px 16px;background:#fff;border:1px solid var(--line)}
.swatches>b{font-family:var(--label);font-weight:800;font-size:12px;letter-spacing:.04em}
.sw-row{display:flex;gap:9px;flex-wrap:wrap}
.sw{width:26px;height:26px;border-radius:50%!important;border:1px solid rgba(0,0,0,.25);display:inline-block;transition:transform .12s}.sw:hover{transform:scale(1.2)}
.sw.on{box-shadow:0 0 0 2px #fff,0 0 0 4px #000}
.sw-clear{font-size:12px;text-decoration:underline;color:#444}
/* menu tài khoản (biểu tượng hình người) */
.acct{position:relative}.acct .icon-btn{position:relative;width:36px;height:36px;border-radius:50%!important}
.acct .icon-btn:hover,.acct .icon-btn.on{background:var(--volt)}
.acct-dot{position:absolute;right:2px;top:3px;width:9px;height:9px;border-radius:50%!important;background:#2bb24c;border:2px solid #fff}
.acct-pop{position:absolute;right:-8px;top:calc(100% + 10px);width:300px;background:#fff;border:2px solid #000;z-index:70;box-shadow:0 12px 32px rgba(0,0,0,.18)}
.acct-head{display:flex;gap:12px;align-items:center;padding:16px;border-bottom:1px solid var(--line)}.acct-head b{display:block;font-size:15px}.acct-head small{color:var(--grey);font-size:12px;word-break:break-all}
.acct-card{margin:12px 16px 0;padding:10px 12px;background:#fbffd9;border-left:4px solid var(--tier,#b87333);display:grid;gap:6px;font-size:13px}
.acct-pts{font-weight:800;background:var(--volt);padding:2px 8px;justify-self:start;font-size:13px}
.acct-links{display:grid;padding:8px 0}.acct-links a{padding:10px 16px;font-size:14px}.acct-links a:hover{background:var(--concrete)}
.acct-admin{font-weight:800;background:var(--volt)}.acct-admin:hover{background:#fff!important;outline:1px solid #000}
.acct-out{width:100%;text-align:left;padding:13px 16px;font-size:14px;font-weight:700;border-top:1px solid var(--line);color:var(--red)}.acct-out:hover{background:#ffeaea}
.acct-guest{padding:18px;display:grid;gap:10px}.acct-guest b{font-family:var(--label);font-size:15px}.acct-guest p{font-size:13px;color:#555}.acct-guest .btn{padding:12px}
@media(max-width:700px){.acct-pop{position:fixed;left:12px;right:12px;top:110px;width:auto}}

/* Footer luôn nằm cuối màn hình */
body{min-height:100vh;display:flex;flex-direction:column}
body>main{flex:1 0 auto}
body>.footer{margin-top:auto}

/* Top bar: thông báo · hỗ trợ · ngôn ngữ · tài khoản */
.utility .spacer{flex:1}
.utility{position:relative}
.ut-btn{display:inline-flex;align-items:center;gap:5px;font-size:12px;color:#222;background:none;border:0;cursor:pointer;padding:2px 0}
.ut-btn:hover{color:#000;text-decoration:none}
.ut-wrap{position:relative}
.ut-badge{font-style:normal;background:#e11d2e;color:#fff;border-radius:9px;font-size:10px;font-weight:800;padding:0 5px;margin-left:2px;line-height:15px}
.ut-pop{position:absolute;top:calc(100% + 6px);right:0;background:#fff;border:1px solid #ddd;box-shadow:0 8px 24px rgba(0,0,0,.12);z-index:80;min-width:210px}
.ut-notes{width:320px;padding:10px 0}.ut-notes>b{display:block;padding:0 14px 8px;font-size:12px;color:#777;border-bottom:1px solid #eee}
.ut-notes p{padding:12px 14px}
.ut-note{display:flex;flex-direction:column;padding:9px 14px;border-bottom:1px solid #f1f1f1;font-size:12px}.ut-note small{color:#777}.ut-note:hover{background:#fbffd9;text-decoration:none!important}
.ut-more{display:block;text-align:center;padding:9px;font-weight:800;font-size:12px}
.ut-lang{padding:6px 0}.ut-lang button{display:block;width:100%;text-align:left;padding:8px 14px;font-size:12px;background:none;border:0;cursor:pointer}.ut-lang button:hover:not(:disabled){background:#fbffd9}.ut-lang .on{font-weight:800}.ut-lang button:disabled{color:#999;cursor:default}
.ut-user{display:inline-flex;align-items:center;gap:6px;font-weight:700;color:#000}
.avatar.sm{width:20px;height:20px;font-size:11px;display:inline-grid;place-items:center;border-radius:50%;background:var(--volt);color:#000;font-weight:800}

/* ===== Dashboard admin ===== */
.dash-hero{display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;background:linear-gradient(120deg,#0b0b0b 0%,#1c1c1c 60%,#2b3a00 100%);color:#fff;padding:26px 28px;border-radius:14px;position:relative;overflow:hidden}
.dash-hero:after{content:"";position:absolute;right:-60px;top:-60px;width:220px;height:220px;border-radius:50%;background:radial-gradient(var(--volt),transparent 70%);opacity:.35}
.dash-hero small{color:var(--volt);font-weight:800;letter-spacing:.08em;text-transform:uppercase;font-size:11px}
.dash-hero h1{font-family:var(--label);font-size:30px;margin:4px 0;letter-spacing:-.01em}.dash-hero p{color:#ccc;font-size:14px}.dash-hero p b{color:var(--volt)}
.dash-quick{display:flex;gap:8px;flex-wrap:wrap;position:relative;z-index:1}
.dash-quick a{background:#ffffff1f;border:1px solid #ffffff40;color:#fff;padding:10px 14px;border-radius:999px;font-size:12px;font-weight:700}.dash-quick a:first-child{background:var(--volt);color:#000;border-color:var(--volt)}.dash-quick a:hover{filter:brightness(1.1);text-decoration:none}
.dash-alerts{display:flex;gap:10px;flex-wrap:wrap}.dash-alerts a{flex:1;min-width:260px;display:flex;align-items:center;gap:8px;background:#fff1f1;border:1px solid #f3b6bb;color:#8a1020;padding:12px 16px;border-radius:10px;font-size:13px}.dash-alerts b{font-size:20px}.dash-alerts span{margin-left:auto;font-weight:800}
.dash-kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:14px}
.dash-kpi{display:flex;gap:14px;align-items:center;background:#fff;border:1px solid var(--line);border-radius:14px;padding:18px;box-shadow:0 1px 2px rgba(0,0,0,.04);transition:transform .15s,box-shadow .15s}.dash-kpi:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(0,0,0,.08)}
.dash-kpi .ico{width:52px;height:52px;border-radius:14px;display:grid;place-items:center;font-size:24px;flex:none}
.dash-kpi.volt .ico{background:#f1ffa6}.dash-kpi.blue .ico{background:#dbeafe}.dash-kpi.green .ico{background:#dcfce7}.dash-kpi.violet .ico{background:#ede9fe}
.dash-kpi small{display:block;font-size:11px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--grey)}
.dash-kpi b{display:block;font-family:var(--label);font-size:24px;letter-spacing:-.02em;line-height:1.2}.dash-kpi em{font-style:normal;font-size:12px;color:var(--grey)}
.dash-row{display:grid;gap:14px}@media(min-width:1100px){.dash-row{grid-template-columns:2fr 1fr}.dash-row.two{grid-template-columns:1fr 1fr}}
.dash-row .panel{border-radius:14px}
.dash-total{font-family:var(--label);font-size:18px;font-weight:800;background:var(--volt);padding:2px 10px;border-radius:999px}
.dash-bars{display:flex;align-items:flex-end;gap:6px;height:230px;padding-top:6px}
.dash-col{flex:1;min-width:0;height:100%;display:grid;grid-template-rows:16px 1fr 16px;gap:4px;justify-items:center}
.dash-col .v{font-size:10px;font-weight:700;color:#555;white-space:nowrap}.dash-col .l{font-size:10px;color:var(--grey)}
.dash-col .b{width:100%;display:flex;align-items:flex-end;justify-content:center;background:repeating-linear-gradient(to top,#f0f0f0 0 1px,transparent 1px 25%);border-radius:6px 6px 0 0}
.dash-col .b i{display:block;width:70%;background:linear-gradient(to top,#8ab800,var(--volt));border-radius:6px 6px 0 0;min-height:2px;transition:filter .15s}.dash-col:hover .b i{filter:brightness(.9)}
.donut-wrap{display:flex;gap:20px;align-items:center;flex-wrap:wrap;justify-content:center}
.donut{width:150px;height:150px;border-radius:50%;display:grid;place-items:center;position:relative}
.donut:before{content:"";position:absolute;inset:22px;background:#fff;border-radius:50%}.donut span{position:relative;text-align:center;font-size:11px;color:var(--grey);line-height:1.1}.donut b{display:block;font-family:var(--label);font-size:28px;color:#000}
.donut-wrap ul{list-style:none;display:grid;gap:8px;font-size:13px;min-width:150px}.donut-wrap li{display:flex;align-items:center;gap:8px}.donut-wrap li i{width:10px;height:10px;border-radius:50%}.donut-wrap li b{margin-left:auto}
.dash-top{display:grid;grid-template-columns:22px 44px 1fr auto;gap:12px;align-items:center;padding:8px 0;border-bottom:1px solid #f1f1f1}.dash-top:hover{background:#fbffd9;text-decoration:none!important}
.dash-top em{font-style:normal;font-weight:800;color:var(--grey);text-align:center}.dash-top .img{position:relative;width:44px;height:44px;border-radius:8px;overflow:hidden;background:#f1f1f1}.dash-top .img img{object-fit:cover}
.dash-top b{font-size:13px;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.dash-top .meter{height:6px;background:#eee;border-radius:3px;margin-top:6px}.dash-top .meter i{display:block;height:100%;background:var(--volt);border:1px solid #000;border-radius:3px}
.dash-order{display:grid;grid-template-columns:38px 1fr auto auto;gap:12px;align-items:center;padding:9px 0;border-bottom:1px solid #f1f1f1}.dash-order:hover{background:#fbffd9;text-decoration:none!important}
.dash-order .av{width:38px;height:38px;border-radius:50%;background:#000;color:var(--volt);display:grid;place-items:center;font-weight:800}
.dash-order b{display:block;font-size:13px}.dash-order small{color:var(--grey);font-size:11px}.dash-order strong{font-size:13px;min-width:92px;text-align:right}
.dash-order .badge{font-size:10px;border-radius:999px;padding:3px 9px;white-space:nowrap}
@media(max-width:600px){.dash-order{grid-template-columns:38px 1fr auto}.dash-order .badge{display:none}}
.dash-order{grid-template-columns:1fr auto;gap:8px;padding:0}
.dash-order:hover{background:none}
.dash-order .do-cust,.dash-order .do-order{display:grid;align-items:center;gap:12px;padding:9px 6px}
.dash-order .do-cust{grid-template-columns:38px 1fr;min-width:0}.dash-order .do-cust b,.dash-order .do-cust small{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;display:block}
.dash-order .do-order{grid-template-columns:auto auto auto;justify-items:end;text-align:right}.dash-order .do-order>div{text-align:right}
.dash-order .do-cust:hover,.dash-order .do-order:hover{background:#fbffd9;text-decoration:none!important}
@media(max-width:600px){.dash-order .do-order{grid-template-columns:auto auto}}

/* Chọn sản phẩm để thanh toán */
.sel-all{display:flex;align-items:center;gap:10px;font-weight:700;font-size:13px;padding:10px 0;cursor:pointer}
.sel-all input,.line-chk,.ci-chk{width:18px;height:18px;accent-color:#000;cursor:pointer;flex:none}
.line{position:relative}.line-chk{position:absolute;left:0;top:6px;z-index:2;background:#fff}.line{padding-left:28px}
.cart-item{position:relative}.ci-chk{position:absolute;left:10px;top:10px;z-index:2}
.cart-item.unsel .ci-img,.cart-item.unsel .ci-body,.line.unsel .line-img,.line.unsel .line-info,.line.unsel .price{opacity:.45}
.btn.disabled,span.btn.disabled{opacity:.45;pointer-events:none}
.inv-logo{display:flex;align-items:flex-end;gap:10px;margin-bottom:10px}.inv-logo span{font-family:var(--display,var(--label));font-weight:900;font-size:32px;letter-spacing:.04em;line-height:1}
.inv .top{justify-content:center;text-align:center}.inv-logo{justify-content:center}
.inv-cust{margin-bottom:-8px!important;line-height:1.3;font-size:15px;letter-spacing:.04em;font-weight:400!important;font-family:var(--body),Arial,sans-serif!important}.inv-cust span{margin-left:6px;font-weight:400}

/* Thông tin cá nhân trong menu tài khoản */
.acct-head-btn{display:flex;align-items:center;gap:12px;width:100%;text-align:left;background:none;border:0;cursor:pointer;font:inherit;color:inherit}
.acct-head-btn:hover b{text-decoration:underline}.acct-chev{margin-left:auto;font-style:normal;color:#777}
.acct-prof{padding:12px 16px;border-bottom:1px solid #eee;background:#fafafa;display:grid;gap:10px;font-size:13px}
.acct-prof dl{display:grid;grid-template-columns:96px 1fr;gap:6px 10px}.acct-prof dt{color:#777;font-size:12px}.acct-prof dd{margin:0;word-break:break-word}.acct-prof em{color:#aaa;font-style:normal}
.acct-prof label{display:grid;gap:4px;font-size:12px;color:#555;font-weight:700}
.acct-prof input,.acct-prof textarea{border:1px solid #ccc;padding:8px;font:inherit;font-size:13px;font-weight:400;border-radius:4px;width:100%}
.acct-prof form{display:grid;gap:10px}.acct-prof-btns{display:flex;gap:8px}.acct-ok{color:#16803c;font-weight:700;font-size:12px}
.acct-head-btn{text-decoration:none!important}
.pf-card{background:#fff;border:1px solid var(--line);max-width:680px;padding:24px;display:grid;gap:18px;margin-top:8px}
.pf-head{display:flex;align-items:center;gap:16px}.pf-head h2{font-size:22px}.pf-head small{color:var(--grey)}.pf-head .btn{margin-left:auto}
.avatar.big{width:64px;height:64px;font-size:28px;display:grid;place-items:center;border-radius:50%;background:var(--volt);color:#000;font-weight:800;border:2px solid #000}
.pf-list{display:grid}.pf-row{display:grid;grid-template-columns:160px 1fr;gap:12px;padding:12px 0;border-top:1px solid #eee;font-size:14px}.pf-row span{color:var(--grey)}.pf-row em{color:#aaa;font-style:normal;font-weight:400}
.pf-form{display:grid;gap:14px}.pf-form label{display:grid;gap:6px;font-size:12px;font-weight:700;color:#555}.pf-form input,.pf-form textarea{border:1px solid #000;padding:10px;font:inherit;font-weight:400;width:100%}
.pf-links{margin-top:16px;font-size:13px}
@media(max-width:600px){.pf-row{grid-template-columns:1fr;gap:2px}}

.colors{margin:4px 0 20px}
.colors-head{display:flex;align-items:baseline;gap:10px;margin-bottom:10px}
.colors-head small{font-family:var(--label);font-weight:800;font-size:12px;letter-spacing:.06em;color:#555}
.colors-head b{font-size:14px}
.colors-row{display:flex;flex-wrap:wrap;gap:10px}
.color-opt{display:block;width:64px;height:80px;overflow:hidden;border:1px solid var(--line);background:#fff;opacity:.85;transition:opacity .12s,transform .12s}
.color-opt:hover{opacity:1;transform:translateY(-2px)}
.color-opt.on{opacity:1;border-color:#000;box-shadow:0 0 0 1px #000}
.color-opt img{width:100%;height:100%;object-fit:cover;display:block}
.colors-head b{font-family:var(--label);font-weight:800;font-size:13px;letter-spacing:.04em}
.colors-head span{font-size:14px;font-weight:600}
.atc .colors{margin:0 0 18px}
.cart-color{display:flex;align-items:center;gap:8px;margin:4px 0;font-size:13px}
.cart-color select{padding:3px 6px;border:1px solid var(--line);background:#fff;font-size:13px}
.auth .forgot{margin:-4px 0 14px;text-align:right;font-size:13px}
.auth .forgot a,.linkish{text-decoration:underline;color:#444;background:none;border:0;padding:0;font:inherit;cursor:pointer}
.auth .muted{margin:0 0 14px;font-size:14px}
.reset-code{font-family:var(--label);font-size:20px;letter-spacing:.2em;background:#000;color:#e2fa1e;padding:2px 10px;margin-left:6px}
.auth a.btn{display:block;text-align:center}
/* ===== đăng nhập / đăng ký / quên mật khẩu ===== */
html{overflow-x:hidden}
.auth-stage{position:relative;width:100vw;margin:-40px 0 -40px calc(50% - 50vw);min-height:calc(100vh - 140px);padding:56px 16px 48px;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#fff;
  background:linear-gradient(180deg,rgba(0,0,0,.55),rgba(0,0,0,.78)),url(/products/w-autumn-hero.jpg) center/cover fixed}
.auth-card{width:100%;max-width:460px;padding:34px 36px 32px;border-radius:22px;background:rgba(18,18,18,.55);border:1px solid rgba(255,255,255,.22);box-shadow:0 30px 80px rgba(0,0,0,.5);-webkit-backdrop-filter:blur(22px) saturate(1.3);backdrop-filter:blur(22px) saturate(1.3)}
.auth-mark{display:flex;align-items:flex-end;justify-content:center;gap:10px;font-family:var(--display);font-size:28px;letter-spacing:.08em;margin-bottom:20px}
.auth-mark .stripes i{background:var(--volt)}
.auth-tabs{display:grid;grid-template-columns:1fr 1fr;gap:4px;padding:4px;margin-bottom:24px;border-radius:999px;background:rgba(255,255,255,.12)}
.auth-tabs a{display:block;text-align:center;padding:11px 8px;border-radius:999px;font-family:var(--label);font-weight:800;font-size:12px;letter-spacing:.12em;color:rgba(255,255,255,.75);transition:background .15s,color .15s}
.auth-tabs a:hover{color:#fff}
.auth-tabs a.on{background:var(--volt);color:#000}
.auth-eyebrow{text-align:center;font-family:var(--label);font-weight:800;font-size:11px;letter-spacing:.18em;color:var(--volt)}
.auth-title{text-align:center;font-size:clamp(38px,6vw,48px);margin:6px 0 8px}
.auth-sub{text-align:center;color:rgba(255,255,255,.72);font-size:14px}
.auth-card form{margin-top:22px}
.auth-card .field{margin-bottom:16px}
.auth-card .field span{color:rgba(255,255,255,.85)}
.input-wrap{position:relative}
.auth-card .field input{height:52px;border:1px solid rgba(255,255,255,.28);border-radius:12px;background:rgba(255,255,255,.1);color:#fff;transition:border-color .15s,background .15s,box-shadow .15s}
.auth-card .field input::placeholder{color:rgba(255,255,255,.45)}
.auth-card .field input:hover{border-color:rgba(255,255,255,.5)}
.auth-card .field input:focus{border:1px solid var(--volt);background:rgba(255,255,255,.16);box-shadow:0 0 0 4px rgba(226,250,30,.25)}
.auth-card .field.bad input{border:1px solid #ff7a7a;box-shadow:0 0 0 4px rgba(255,90,90,.2)}
.auth-card .field em{color:#ff9d9d}
.auth-card input:-webkit-autofill{-webkit-text-fill-color:#fff;transition:background-color 9999s}
.auth-card .input-wrap input[name=password],.auth-card .input-wrap input[name=confirm]{padding-right:70px}
.eye{position:absolute;right:6px;top:6px;height:40px;padding:0 12px;border-radius:9px;font-family:var(--label);font-weight:800;font-size:10.5px;letter-spacing:.1em;color:rgba(255,255,255,.8)}.eye:hover{color:var(--volt)}
.auth-card .forgot{margin:-6px 0 18px;text-align:right;font-size:13px}
.auth-card .forgot a,.auth-card .linkish{color:rgba(255,255,255,.8);text-decoration:underline;background:none;border:0;padding:0;font:inherit;cursor:pointer}
.auth-card .btn.full{padding:17px 28px;border:0;border-radius:999px;font-size:14px;background:var(--volt);color:#000;box-shadow:0 10px 26px rgba(226,250,30,.28);transition:transform .12s,box-shadow .12s,filter .12s}
.auth-card .btn.full:hover:not(:disabled){transform:translateY(-2px);box-shadow:0 14px 32px rgba(226,250,30,.4);filter:brightness(1.05)}
.auth-card .btn.full:disabled{box-shadow:none}
.auth-card a.btn{display:block}
.auth-card .switch{margin-top:22px;color:rgba(255,255,255,.75)}
.auth-card .switch a{color:#fff}
.auth-card .notice{margin:14px 0 0;background:rgba(226,250,30,.12);border:1px solid rgba(226,250,30,.4);border-left:4px solid var(--volt);border-radius:10px;color:#fff;font-size:13.5px}
.auth-card .notice small{color:rgba(255,255,255,.8)}
.auth-card .form-err{background:rgba(255,90,90,.16);border:1px solid rgba(255,120,120,.5);border-radius:10px;color:#ffc2c2}
.auth-card .form-err a{color:#fff}
.auth-card .muted,.auth-card .auth-sub{color:rgba(255,255,255,.72)}
.reset-code{border-radius:6px}
.auth-perks{list-style:none;display:flex;justify-content:center;flex-wrap:wrap;gap:10px;margin-top:26px}
.auth-perks li{padding:8px 16px;border-radius:999px;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.2);font-family:var(--label);font-weight:800;font-size:11.5px;letter-spacing:.05em;-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px)}
/* gợi ý "Có thể bạn cũng thích" dưới danh sách sản phẩm */
.container.section>.prow{margin-top:64px;padding-top:36px;border-top:1px solid var(--line)}
.container.section>.prow .sec-head{margin-bottom:22px;justify-content:flex-start}
@media(max-width:700px){.container.section>.prow{margin-top:44px;padding-top:28px}}

/* nút giỏ hàng: biểu tượng xe đẩy, chấm số lượng ở góc, chú thích khi rê chuột */
.cart-btn{position:relative;width:46px;height:46px;display:grid;place-items:center;gap:0;margin-left:2px;border:2px solid #000;background:#fff;color:#000;transition:background .15s,transform .15s}
.cart-btn svg{transition:transform .2s}
.cart-btn:hover,.cart-btn:focus-visible{background:var(--volt);outline:0}
.cart-btn:hover svg,.cart-btn:focus-visible svg{transform:translateX(2px) rotate(-6deg)}
.cart-btn .cart-count{position:absolute;top:-9px;right:-9px;min-width:20px;height:20px;padding:0 5px;border:2px solid #000;border-radius:999px;background:var(--red);color:#fff;font-family:var(--label);font-weight:800;font-size:10.5px;line-height:1;display:grid;place-items:center}
.cart-btn::after{content:attr(data-tip);position:absolute;top:calc(100% + 12px);right:0;white-space:nowrap;background:#000;color:#fff;font-family:var(--label);font-weight:800;font-size:11.5px;letter-spacing:.08em;text-transform:uppercase;padding:7px 12px;opacity:0;transform:translateY(-4px);pointer-events:none;transition:opacity .15s,transform .15s;z-index:60}
.cart-btn::before{content:"";position:absolute;top:calc(100% + 6px);right:16px;border:6px solid transparent;border-bottom-color:#000;border-top-width:0;opacity:0;transform:translateY(-4px);pointer-events:none;transition:opacity .15s,transform .15s;z-index:60}
.cart-btn:hover::after,.cart-btn:hover::before,.cart-btn:focus-visible::after,.cart-btn:focus-visible::before{opacity:1;transform:none}
@media(hover:none){.cart-btn::after,.cart-btn::before{display:none}}

/* tên màu cạnh tên sản phẩm + mô tả chi tiết */
.pdp-title{display:flex;flex-wrap:wrap;align-items:center;gap:6px 14px;margin:6px 0 10px}
.pdp-title h1{margin:0}
.pdp-color{display:inline-flex;align-items:center;gap:7px;padding:5px 12px;border:1.5px solid #000;font-family:var(--label);font-weight:800;font-size:11.5px;letter-spacing:.06em;text-transform:uppercase;background:#fff;white-space:nowrap}
.pdp-color i,.card-color i{width:10px;height:10px;border-radius:50%;background:conic-gradient(#e32b2b,#e2fa1e,#2a9d8f,#3b5bdb,#e32b2b);flex:none}
.pdp-color b{font-weight:800}
.card-color{display:flex;align-items:center;gap:6px;margin:3px 0 6px;font-size:12px;color:#555}
.pd{padding-top:8px}
.pd-grid{display:grid;grid-template-columns:1.1fr 1fr;gap:40px;align-items:start}
.pd-text h3{font-family:var(--label);font-weight:800;font-size:13px;letter-spacing:.1em;text-transform:uppercase;margin:22px 0 8px}
.pd-text h3:first-child{margin-top:0}
.pd-text p{font-size:15px;line-height:1.7;color:#333;margin-bottom:10px}
.pd-text ul{margin:0 0 6px 18px;display:grid;gap:6px;font-size:14.5px;line-height:1.55;color:#333}
.pd-table{width:100%;border-collapse:collapse;border:1px solid var(--line);font-size:14px}
.pd-table th,.pd-table td{padding:12px 14px;text-align:left;vertical-align:top;border-bottom:1px solid var(--line)}
.pd-table th{width:36%;background:var(--concrete);font-family:var(--label);font-weight:800;font-size:11.5px;letter-spacing:.06em;text-transform:uppercase;color:#333}
.pd-table tr:last-child th,.pd-table tr:last-child td{border-bottom:0}
@media(max-width:860px){.pd-grid{grid-template-columns:1fr;gap:24px}}

.rv-meta{margin:2px 0 4px;font-size:12px;color:#777}
.rv-note{margin-top:16px}
/* banner: chừa chỗ cho dấu mũ/dấu thanh của chữ tiếng Việt, không đè lên nhãn phía trên */
.carousel .bh-text .bh-tag{margin-bottom:0}
.carousel .bh-text h1{line-height:1.04;margin:clamp(30px,3.6vw,56px) 0 18px}
/* thông báo nổi */
.toasts{position:fixed;bottom:24px;left:24px;z-index:1000;display:flex;flex-direction:column-reverse;gap:10px;width:min(380px,calc(100vw - 32px));pointer-events:none}
.toast{position:relative;pointer-events:auto;display:flex;align-items:flex-start;gap:12px;padding:14px 38px 16px 14px;background:#fff;color:#111;border:2px solid #000;box-shadow:5px 5px 0 #000;overflow:hidden;animation:toastin .28s cubic-bezier(.2,.8,.2,1) both}
.toast-ic{flex:none;width:30px;height:30px;display:grid;place-items:center;border-radius:50%;font-weight:800;font-size:15px;color:#000;background:var(--volt);border:2px solid #000}
.t-error .toast-ic{background:var(--red);color:#fff}.t-info .toast-ic{background:#cfe3ff}
.toast-tx{display:grid;gap:2px;min-width:0}
.toast-tx b{font-family:var(--label);font-weight:800;font-size:12.5px;letter-spacing:.06em;text-transform:uppercase}
.toast-tx span{font-size:13.5px;line-height:1.4;color:#333;overflow-wrap:anywhere}
.toast-x{position:absolute;top:8px;right:8px;width:24px;height:24px;font-size:12px;color:#666}.toast-x:hover{color:#000;background:#f0f0f0}
.toast-bar{position:absolute;left:0;bottom:0;height:3px;width:100%;background:var(--volt);transform-origin:left;animation:toastbar linear forwards}
.t-error .toast-bar{background:var(--red)}.t-info .toast-bar{background:#4a8dff}
@keyframes toastin{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}
@keyframes toastbar{from{transform:scaleX(1)}to{transform:scaleX(0)}}
@media(max-width:600px){.toasts{bottom:14px;right:12px;left:12px;width:auto}}
@media(prefers-reduced-motion:reduce){.toast{animation:none}.toast-bar{animation:none;display:none}}
